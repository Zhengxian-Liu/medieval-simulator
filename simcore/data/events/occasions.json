{
  // Occasions the family is asked to (design/news.md): when news of a death or a wedding reaches the family from a
  // house it is close to, that house asks them over. {target} is the dead (or the groom), {target_home} their
  // family. Going, or staying away, is remembered by that house; at a wake or a wedding the family also meets the
  // other houses that came. The player's answer becomes the family's standing rule (all / only the close, word sent
  // to the rest / none, or keep asking): later wakes and weddings follow it without a card (World::occasionByPolicy),
  // and the rule can be changed at any time on the page (家裡的規矩). The AI standing in for a card sets no rule.
  "events": [
    {"id": "funeral_invite", "title": "喪事", "scope": "player_family", "chance": 1,
     "on": {"signal": "news:funeral", "after_months": [0, 0]},
     "conditions": {"age": [14, 120]},
     "prompt": "{target_home}家的{target_first}走了。那邊來人傳話：今晚守靈，明天下葬，請你們過去。",
     "prompts": ["{target_home}家的{target_first}走了。那邊來人傳話：今晚守靈，明天下葬，請你們過去。",
                 "教堂的喪鐘敲了九下又敲了幾下，是替{target_home}家的{target_first}敲的。他家的孩子跑來說：今晚守靈，請你們去坐坐。",
                 "{target_home}家門口掛起了黑布。{target_first}走了，明天一早下葬，他家托人來問你們今晚過不過去。"],
     "prompt_if": [
       {"cond": {"target": {"died_suddenly": true}}, "prompt": "{target_home}家的{target_first}走得突然，前幾天還在田埂上跟人說笑。他家亂成一團，來人傳話：今晚守靈，請你們過去幫幫手。"},
       {"cond": {"target": {"age": [0, 12]}}, "prompt": "{target_home}家的小{target_first}沒熬過去。小小的棺材明天就要下葬，他家來人說：今晚守靈，人不用多，來坐坐就好。"},
       {"cond": {"target": {"age": [65, 120]}}, "prompt": "{target_home}家的老{target_first}走了，活了這麼大歲數，在村裡算是喜喪。今晚守靈，他家說要好好熱鬧一場，請你們過去。"}
     ],
     "options": [
      {"text": "帶上麵包和一罐麥酒去守靈，陪他們坐一夜（2 便士，佔一段空閒）；往後家裡的規矩：紅白事都好好去",
       "conditions": {"money_ge": 2},
       "log": "{name}帶著麵包和一罐麥酒去{target_home}家守靈，陪他們坐到天亮。",
       "effects": [{"money": -2}, {"spend_time": 1}, {"occasion": {"came": true, "value": 8, "mod": "came_to_wake"}}, {"need": {"social": 15, "spirit": 10}}, {"occasion_policy": "all"}],
       "ai": {"base": 8, "traits": {"kind": 6, "pious": 4, "generous": 4, "greedy": -5, "shy": -3}, "if": [{"cond": {"news_link_ge": 0.6}, "add": 8}]}},
      {"text": "下葬那天去教堂墓地送一程；往後家裡的規矩：親近的人家才去，別家託人帶個話",
       "log": "{target_home}家的{target_first}下葬那天，{name}站在教堂墓地的人群裡送了一程。",
       "effects": [{"occasion": {"came": true, "value": 4, "mod": "came_to_wake"}}, {"need": {"spirit": 8}}, {"occasion_policy": "close"}],
       "ai": {"base": 8, "traits": {"pious": 3}}},
      {"text": "帶上麵包和麥酒去守靈（2 便士，佔一段空閒）；往後的紅白事還是每次問我",
       "conditions": {"money_ge": 2},
       "log": "{name}帶著麵包和一罐麥酒去{target_home}家守靈，陪他們坐到天亮。",
       "effects": [{"money": -2}, {"spend_time": 1}, {"occasion": {"came": true, "value": 8, "mod": "came_to_wake"}}, {"need": {"social": 15, "spirit": 10}}, {"occasion_policy": "ask"}],
       "ai": {"base": 2}},
      {"text": "下葬那天去教堂墓地送一程；往後的紅白事還是每次問我",
       "conditions": {"money_lt": 2},
       "log": "{target_home}家的{target_first}下葬那天，{name}站在教堂墓地的人群裡送了一程。",
       "effects": [{"occasion": {"came": true, "value": 4, "mod": "came_to_wake"}}, {"need": {"spirit": 8}}, {"occasion_policy": "ask"}],
       "ai": {"base": 2}},
      // This time only (no rule set): what the house has to give besides a night, and what it buys.
      {"text": "扛一袋麥子去，給{target_home}家辦喪宴撐場面（約 10 天的糧，佔一段空閒；全村都看在眼裡）",
       "conditions": {"not": {"food_days_lt": 120}},
       "log": "{name}扛著一袋麥子去{target_home}家守靈。喪宴上的麵包是用{house}家的麥子烤的，來的人都知道。",
       "effects": [{"give_food_target": 10}, {"spend_time": 1}, {"occasion": {"came": true, "value": 12, "mod": "came_to_wake"}}, {"reputation": 1}, {"need": {"social": 15, "spirit": 10}}],
       "ai": {"base": 3, "traits": {"generous": 8, "gregarious": 3, "greedy": -6}, "if": [{"cond": {"news_link_ge": 0.6}, "add": 4}]}},
      {"text": "替{target_first}點一對蠟燭、請神父多念一段（4 便士，佔一段空閒；{target_home}家會記得）",
       "conditions": {"money_ge": 4},
       "log": "{name}去{target_home}家守靈，又在教堂替{target_first}點了一對蠟燭，請神父在彌撒裡多念了一段。",
       "effects": [{"money": -4}, {"spend_time": 1}, {"occasion": {"came": true, "value": 11, "mod": "came_to_wake"}}, {"need": {"spirit": 20, "social": 10}}],
       "ai": {"base": 2, "traits": {"pious": 8, "greedy": -4}}},
      {"text": "趁守靈去{target_home}家靈前賠個不是，把兩家的舊帳放下（2 便士，佔一段空閒；他家肯不肯是另一回事）",
       "conditions": {"money_ge": 2, "feud_ge": 1},
       "log": "{name}去{target_home}家守靈，在{target_first}靈前站了很久，才開口說：兩家的事，到這裡為止吧。",
       "effects": [{"money": -2}, {"spend_time": 1}, {"occasion": {"came": true, "value": 10, "mod": "came_to_wake"}},
                   {"random": {"percent": 50, "effects": [{"end_feud": "守靈那夜在靈前放下了舊怨"}, {"log": "  {target_home}家的人沉默了一會兒，給{name}倒了一杯酒。"}],
                               "else": [{"log": "  {target_home}家的人別過臉去，誰也沒接話。{name}坐到天亮，一個人回了家。"}]}}],
       "ai": {"base": 4, "traits": {"forgiving": 8, "kind": 4, "wrathful": -6}}},
      {"text": "地裡的活走不開，不去了；往後家裡的規矩：紅白事都不去",
       "log": "{target_home}家的{target_first}下葬那天，{name}沒有去。",
       "effects": [{"occasion": {"came": false, "value": -6, "mod": "missed_funeral"}}, {"work_bonus": 0.01}, {"occasion_policy": "none"}],
       "ai": {"base": 3, "traits": {"greedy": 4, "shy": 4, "diligent": 3, "cruel": 3}, "if": [{"cond": {"news_link_ge": 0.6}, "add": -3}]}}
     ]},

    {"id": "wedding_invite", "title": "喜酒", "scope": "player_family", "chance": 1,
     "on": {"signal": "news:wedding", "after_months": [0, 0]},
     "conditions": {"age": [14, 120]},
     "prompt": "{target_house}家的{target_first}要成親了，請你們去喝喜酒。",
     "prompts": ["{target_house}家的{target_first}要成親了，請你們去喝喜酒。",
                 "神父在主日念了三次{target_house}家{target_first}的婚約，沒人出來反對。下禮拜在教堂門口成婚，他家請你們去喝喜酒。",
                 "{target_house}家的院子裡已經在搭棚子、借長凳了。{target_first}要成親，他家的孩子挨家挨戶來請。"],
     "options": [
      {"text": "帶一份賀禮去喝喜酒（3 便士，佔一段空閒）；往後家裡的規矩：紅白事都好好去",
       "conditions": {"money_ge": 3},
       "log": "{name}帶著賀禮去喝{target}的喜酒，跳舞跳到半夜。",
       "effects": [{"money": -3}, {"spend_time": 1}, {"occasion": {"came": true, "value": 7, "mod": "wedding_gift"}}, {"need": {"social": 25}}, {"occasion_policy": "all"}],
       "ai": {"base": 8, "traits": {"generous": 6, "gregarious": 5, "greedy": -5, "shy": -4}, "if": [{"cond": {"news_link_ge": 0.6}, "add": 6}]}},
      {"text": "空著手去湊個熱鬧；往後家裡的規矩：親近的人家才去，別家託人帶個話",
       "log": "{name}空著手去{target}的喜酒上湊了個熱鬧。",
       "effects": [{"occasion": {"came": true, "value": 2, "mod": "came_to_wedding"}}, {"need": {"social": 15}}, {"occasion_policy": "close"}],
       "ai": {"base": 6, "traits": {"greedy": 4, "gregarious": 3}}},
      {"text": "帶一份賀禮去喝喜酒（3 便士，佔一段空閒）；往後的紅白事還是每次問我",
       "conditions": {"money_ge": 3},
       "log": "{name}帶著賀禮去喝{target}的喜酒，跳舞跳到半夜。",
       "effects": [{"money": -3}, {"spend_time": 1}, {"occasion": {"came": true, "value": 7, "mod": "wedding_gift"}}, {"need": {"social": 25}}, {"occasion_policy": "ask"}],
       "ai": {"base": 2}},
      {"text": "空著手去湊個熱鬧；往後的紅白事還是每次問我",
       "conditions": {"money_lt": 3},
       "log": "{name}空著手去{target}的喜酒上湊了個熱鬧。",
       "effects": [{"occasion": {"came": true, "value": 2, "mod": "came_to_wedding"}}, {"need": {"social": 15}}, {"occasion_policy": "ask"}],
       "ai": {"base": 2}},
      {"text": "扛一桶麥酒、一袋麵粉去辦喜宴（約 10 天的糧，佔一段空閒；全村都看在眼裡）",
       "conditions": {"not": {"food_days_lt": 120}},
       "log": "{name}扛著一桶麥酒、一袋麵粉去喝{target}的喜酒。那天喜宴上的酒，有一半是{house}家的。",
       "effects": [{"give_food_target": 10}, {"spend_time": 1}, {"occasion": {"came": true, "value": 12, "mod": "wedding_gift"}}, {"reputation": 1}, {"need": {"social": 25}}],
       "ai": {"base": 3, "traits": {"generous": 8, "gregarious": 4, "greedy": -6}}},
      // A wedding feast before an election: the whole village is at the tables.
      {"text": "喜宴上請滿桌的人喝酒，替家裡攢人緣（8 便士，佔一段空閒；到選村裡的差事時，各家都記得）",
       "conditions": {"money_ge": 8, "any": [{"ambition": "become_reeve"}, {"ambition": "village_offices"}, {"family_offices_ge": 1}, {"reeve": true}]},
       "log": "{name}在{target}的喜宴上一桌一桌敬酒，請大家喝了好幾壺。散席時，好幾家拍著{name}的肩膀說：「你家是靠得住的。」",
       "effects": [{"money": -8}, {"spend_time": 1}, {"occasion": {"came": true, "value": 8, "mod": "wedding_gift"}}, {"village_opinion": {"value": 2, "mod": "good_times", "years": 2}}, {"need": {"social": 30}}],
       "ai": {"base": 4, "traits": {"ambitious": 8, "gregarious": 6, "greedy": -6, "shy": -6}}},
      {"text": "不去了；往後家裡的規矩：紅白事都不去",
       "log": "{target}成親那天，{name}沒有去。",
       "effects": [{"occasion": {"came": false, "value": -3, "mod": "missed_wedding"}}, {"occasion_policy": "none"}],
       "ai": {"base": 3, "traits": {"shy": 6, "cynical": 3}, "if": [{"cond": {"news_link_ge": 0.6}, "add": -2}]}}
     ]}
  ]
}
