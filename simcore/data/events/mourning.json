       "ai": {"base": 4, "traits": {"greedy": 10, "ambitious": 6, "kind": -8}}},
      {"text": "上門說清楚：秋收以後一定要還（不鬆口，{target_first}會記著）",
       "log": "{name}上門對{target}說：「難處我知道，可秋收以後，該還的還是要還。」",
       "effects": [{"target_opinion": {"value": -6, "mod": "no_mercy", "years": 8}}],
       "ai": {"base": 5, "traits": {"greedy": 6, "diligent": 3}}}
