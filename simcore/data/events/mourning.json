{
  // What big events leave behind, coming back as moments (design/season-loop.md). "bereaved:<relation>" fires for
  // each mourner with the dead as {target}; "concern:<kind>" fires when a concern first takes hold, and with
  // "as": "head" it comes to the head of the holder's house, the holder as {target}.
  "events": [
    // A baby lost: a small card of its own, and a second one inside the year is a quiet line (many did not live).
    {"id": "mourn_infant", "title": "孩子沒保住", "scope": "player_family", "chance": 1, "cooldown_months": 12, "cooldown_scope": "household",
     "quiet_log": "家裡又埋了一個小的。{name}把{target_first}的小衣裳收進箱底，沒有再多說什麼。",
     "on": {"signal": "bereaved:child", "after_months": [0, 0]},
     "conditions": {"age": [16, 120], "target": {"age": [0, 2]}},
     "prompt": "{target}沒能熬過這一季。小小的一個，用一塊舊麻布包著就放得下。{name}抱著不肯撒手。",
     "prompt_if": [
       {"cond": {"target": {"died_suddenly": true}}, "prompt": "早上{target_first}還好好的，到了下午就沒了氣息。{name}抱著那小小的身子，怎麼也焐不熱。"},
       {"cond": {"food_days_lt": 40}, "prompt": "{target}沒能熬過這一季。這一冬家裡本來就吃不飽，奶水也少，{name}總想，要是家裡多一口吃的，是不是就保住了。"}
     ],
     "options": [
      {"text": "求神父替孩子做一場彌撒（6 便士）",
       "log": "{name}求神父替小{target_first}做了一場彌撒，埋在教堂墓地靠牆的一角。",
       "effects": [{"money": -6}, {"ease_concern": {"kind": "grief", "by": 18}}, {"ease_concern_house": {"kind": "grief", "by": 10}}, {"need": {"spirit": 40}}, {"stress": -5}],
       "ai": {"base": 8, "traits": {"pious": 10, "generous": 3, "greedy": -6}}},
      {"text": "點一盞長明燈，一家人守一夜（1 便士）",
       "log": "{name}點了一盞長明燈，一家人守著小{target_first}過了一夜。",
       "effects": [{"money": -1}, {"ease_concern": {"kind": "grief", "by": 10}}, {"ease_concern_house": {"kind": "grief", "by": 8}}, {"need": {"spirit": 20}}],
       "ai": {"base": 10, "traits": {"pious": 4, "kind": 4}}},
      {"text": "悄悄埋了，第二天照常幹活（不花錢，心裡憋著）",
       "log": "{name}悄悄把小{target_first}埋了，第二天照常下田，一句話也沒說。",
       "effects": [{"work_bonus": 0.01}, {"stress": 6}],
       "ai": {"base": 6, "traits": {"diligent": 6, "calm": 4, "greedy": 3}}}
     ]},

    // An older child: one card for each death (both parents grieve it, the house answers once).
    {"id": "mourn_child", "title": "喪子", "scope": "player_family", "chance": 1, "cooldown_months": 2, "cooldown_scope": "household",
     "quiet_log": "家裡又埋了一個孩子。{name}把{target_first}的{target_keepsake}收進箱底，沒有再多說什麼。",
     "on": {"signal": "bereaved:child", "after_months": [0, 0]},
     "conditions": {"age": [16, 120], "target": {"age": [3, 120]}},
     "prompt": "{target}走了。{name}坐在{target_first}睡過的草墊旁，一整天沒說話。",
     "prompt_if": [
       {"cond": {"target": {"died_suddenly": true}}, "prompt": "早上{target_first}還在院子裡追雞，到了下午，人是讓鄰居抱回來的。{name}跪在地上，怎麼搖也搖不醒。"},
       {"cond": {"target": {"age": [12, 40]}}, "prompt": "{target}走了。那麼大的人了，眼看就能頂起家裡一半的活。{name}站在墳前，想起還沒替{target_first}辦成的那些事。"},
       {"cond": {"food_days_lt": 40}, "prompt": "{target}走了。這一冬家裡本來就吃不飽，{name}總想，要是多給{target_first}一口吃的，是不是就熬過去了。"}
     ],
     "options": [
      {"text": "守靈三天，給孩子點長明燈（3 便士）",
       "log": "{name}替{target}守了三天靈，長明燈一直沒熄。",
       "effects": [{"money": -3}, {"ease_concern": {"kind": "grief", "by": 10}}, {"ease_concern_house": {"kind": "grief", "by": 6}}, {"need": {"spirit": 20}}],
       "ai": {"base": 10, "traits": {"pious": 6, "kind": 3}}},
      {"text": "求神父替孩子做一場彌撒（6 便士）",
       "log": "{name}求神父替{target}做了一場彌撒，願{target_first}的靈魂早日安息。",
       "effects": [{"money": -6}, {"ease_concern": {"kind": "grief", "by": 18}}, {"ease_concern_house": {"kind": "grief", "by": 10}}, {"need": {"spirit": 40}}, {"stress": -5}],
       "ai": {"base": 8, "traits": {"pious": 10, "generous": 3, "greedy": -6}}},
      // Spare grain turned into the village's goodwill: a public thing, so it moves the name.
      {"text": "開一桶麥酒、蒸幾籠麵包，請鄰居來送{target_first}一程（約 10 天的糧；來的人家都會記得）",
       "conditions": {"not": {"food_days_lt": 100}},
       "log": "{name}開了一桶麥酒，請鄰居來喝喪酒。半個村子的人擠在院子裡，說起{target_first}小時候的淘氣事，說著說著都紅了眼眶。",
       "effects": [{"food_days": -10}, {"ease_concern": {"kind": "grief", "by": 12}}, {"ease_concern_house": {"kind": "grief", "by": 8}}, {"reputation": 1}, {"village_opinion": {"value": 2, "mod": "gift", "years": 3}}, {"need": {"social": 15}}],
       "ai": {"base": 5, "traits": {"generous": 8, "gregarious": 5, "greedy": -6, "shy": -4}}},
      {"text": "去酒館喝到不省人事（2 便士）",
       "log": "埋了{target}那晚，{name}在酒館喝到不省人事，被人抬回了家。",
       "effects": [{"money": -2}, {"ease_concern": {"kind": "grief", "by": 8}}, {"stress": -10}, {"health": -4}, {"trait_chance": {"trait": "drunkard", "chance": 10}}],
       "ai": {"base": 4, "traits": {"drunkard": 12, "melancholy": 4, "wrathful": 3}}},
      {"text": "第二天照樣下田，什麼也不說（田裡不耽誤，心裡憋著）",
       "log": "埋了{target}，{name}第二天照樣下田，一句話也沒說。",
       "effects": [{"work_bonus": 0.02}, {"stress": 6}],
       "ai": {"base": 6, "traits": {"diligent": 8, "calm": 4, "cruel": 3}}}
     ]},

    // Told by how it came (a second loss, all at once, a short or a long marriage, little children left), first match.
    {"id": "mourn_spouse", "title": "喪偶", "scope": "player_family", "chance": 1,
     "on": {"signal": "bereaved:spouse", "after_months": [0, 0]},
     "prompt": "{target}走了。床的另一半空了，{name}夜裡還會伸手去摸。",
     "prompt_if": [
       {"cond": {"flag": "widowed_again"}, "prompt": "不到五年，{name}又站在墳前。上一回埋的那個人還沒忘掉，如今{target}也走了。村裡有人在背後說{name}命硬。"},
       {"cond": {"target": {"died_suddenly": true}}, "prompt": "早上{target_first}出門的時候還好好的，到了傍晚，人是讓鄰居抬回來的。{name}到現在還不肯信。"},
       {"cond": {"married_years_lt": 3}, "prompt": "才成親沒幾年，{target}就走了。新縫的被面還沒洗舊，{name}已經一個人睡在上頭。"},
       {"cond": {"any_child": {"age": [0, 9]}}, "prompt": "{target}走了。孩子們還不懂，一直問{target_pron}什麼時候回來。{name}答不上來，只能把他們摟緊一點。"},
       {"cond": {"married_years_ge": 25}, "prompt": "{name}和{target_first}做了二十多年夫妻，吵過，也一起熬過荒年。往後吃飯，桌邊少了一個人。"}
     ],
     "options": [
      {"text": "請神父做彌撒，好好送{target_pron}走（6 便士）",
       "log": "{name}請神父替{target}做了彌撒，全村的人都來送了。",
       "effects": [{"money": -6}, {"ease_concern": {"kind": "grief", "by": 15}}, {"need": {"spirit": 35}}, {"reputation": 1}, {"set_flag": "mourned_spouse"}],
       "ai": {"base": 10, "traits": {"pious": 8, "generous": 3, "greedy": -6}}},
      {"text": "把孩子們叫到身邊，告訴他們往後要互相照應", "conditions": {"living_children_ge": 1},
       "log": "埋了{target}那晚，{name}把孩子們叫到身邊：「往後就剩咱們了，要互相照應。」",
       "effects": [{"ease_concern": {"kind": "grief", "by": 8}}, {"ease_concern_house": {"kind": "grief", "by": 10}}, {"household_opinion": {"value": 4, "mod": "comforted", "years": 8}}, {"set_flag": "mourned_spouse"}],
       "ai": {"base": 8, "traits": {"kind": 8, "gregarious": 3}}},
      {"text": "把{target_pron}的衣服收進箱子，不讓人碰",
       "log": "{name}把{target}的衣服疊好收進箱子，誰也不許碰。",
       "effects": [{"ease_concern": {"kind": "grief", "by": 6}}, {"trait_chance": {"trait": "melancholy", "chance": 12}}, {"set_flag": "mourned_spouse"}],
       "ai": {"base": 6, "traits": {"melancholy": 8, "shy": 4, "chaste": 3}}},
      {"text": "咬牙撐起這個家",
       "log": "埋了{target}，{name}咬著牙把家裡的活全扛了起來。",
       "effects": [{"work_bonus": 0.02}, {"stress": 6}, {"skill": {"farming": 0.5}}, {"set_flag": "mourned_spouse"}],
       "ai": {"base": 8, "traits": {"diligent": 8, "brave": 4, "calm": 3}}}
     ]},

    // A brother or sister gone (at home, or word of it from away).
    {"id": "mourn_sibling", "title": "手足", "scope": "player_family", "chance": 0.7, "cooldown_years": 2,
     "on": {"signal": "bereaved:sibling", "after_months": [0, 1]},
     "conditions": {"age": [8, 120]},
     "prompt": "{target}走了。{name}總想起小時候和{target_first}一起在河邊摸魚、搶一塊麵包的樣子。",
     "prompts": ["{target}走了。{name}總想起小時候和{target_first}一起在河邊摸魚、搶一塊麵包的樣子。",
                 "{target}走了。{name}想起那年冬天，兩人擠在一張草墊上，{target_first}把自己那半條毯子也蓋到{name}身上。",
                 "{target}走了。這些年各忙各的，{name}和{target_first}一年也說不上幾句話。如今想說，已經來不及了。"],
     "prompt_if": [
       {"cond": {"target": {"died_suddenly": true}}, "prompt": "{target}說走就走了，前一天還在{name}家門口借了把鐮刀。那把鐮刀現在還靠在牆邊。"},
       {"cond": {"age": [8, 13]}, "prompt": "{target}走了。{name}還小，不太懂死是什麼，只知道往後吃飯，桌邊少了一個搶麵包的人。"}
     ],
     "options": [
      {"text": "去{target_first}墳前放一把野花", "log": "{name}去{target}墳前放了一把野花，坐了很久。",
       "effects": [{"ease_concern": {"kind": "grief", "by": 12}}, {"need": {"spirit": 10}}],
       "ai": {"base": 8, "traits": {"kind": 6, "melancholy": 4}}},
      {"text": "把{target_first}留下的小刀收起來，留個念想", "log": "{name}把{target}留下的一把小刀收進了自己的包袱。",
       "effects": [{"ease_concern": {"kind": "grief", "by": 8}}],
       "ai": {"base": 6, "traits": {"shy": 4, "content": 4}}},
      {"text": "把眼淚吞回去，照常幹活", "log": "{name}一句話也沒說，照常下田去了。",
       "effects": [{"stress": 6}, {"work_bonus": 0.01}],
       "ai": {"base": 6, "traits": {"diligent": 6, "calm": 4}}}
     ]},

    // One of the house died away from it (at school, in town, at the war): word comes, and the one keeping the house
    // decides what is done for them. The dead is {target}.
    {"id": "word_from_away", "title": "從外頭捎來的消息", "scope": "player_family", "chance": 1,
     "on": {"signal": "bereaved:away", "after_months": [0, 0]},
     "prompt": "從外頭捎來消息：{target}死在外地了，人還停在那邊的教堂裡。家裡得拿個主意。",
     "options": [
      {"text": "派人把{target_first}運回來，葬在村裡的墓地（12 便士）",
       "log": "{name}託人雇了一輛車，把{target}運回村裡，葬在教堂墓地。全家都去送了。",
       "effects": [{"money": -12}, {"ease_concern_house": {"kind": "grief", "by": 15}}, {"need": {"spirit": 20}}, {"reputation": 1}],
       "ai": {"base": 10, "traits": {"kind": 6, "pious": 4, "greedy": -6}}},
      {"text": "請神父替{target_first}做一台彌撒（4 便士）",
       "log": "{target}葬在了外地。{name}請神父做了一台彌撒，全家跪在教堂裡替{target_pron}禱告。",
       "effects": [{"money": -4}, {"ease_concern_house": {"kind": "grief", "by": 8}}, {"need": {"spirit": 25}}],
       "ai": {"base": 8, "traits": {"pious": 8}}},
      {"text": "家裡拿不出錢，只能點一根蠟燭",
       "log": "{target}葬在了外地，家裡拿不出錢。{name}在灶台邊點了一根蠟燭，一家人坐了一夜。",
       "effects": [{"ease_concern_house": {"kind": "grief", "by": 3}}, {"stress": 6}],
       "ai": {"base": 4, "traits": {"greedy": 6}}}
     ]},

    {"id": "mourn_parent", "title": "送終", "scope": "player_family", "chance": 0.7,
     "on": {"signal": "bereaved:parent", "after_months": [0, 0]},
     "conditions": {"age": [12, 120]},
     "prompt": "{target}下葬了。{name}跪在墳前，想起{target_first}從前說過的話。",
     "options": [
      {"text": "在墳前發誓不讓家道中落",
       "log": "{name}跪在{target}墳前發誓，絕不讓家道在自己手上中落。",
       "effects": [{"ease_concern": {"kind": "grief", "by": 10}}, {"stress": 3}, {"trait_chance": {"trait": "ambitious", "chance": 8}}],
       "ai": {"base": 8, "traits": {"ambitious": 8, "brave": 3}}},
      {"text": "捐 2 便士給教堂，替{target_first}祈禱",
       "log": "{name}捐了 2 便士給教堂，請神父在禱告時提{target}的名字。",
       "effects": [{"money": -2}, {"ease_concern": {"kind": "grief", "by": 15}}, {"need": {"spirit": 30}}],
       "ai": {"base": 8, "traits": {"pious": 8, "greedy": -4}}},
      {"text": "哭一場，日子照過",
       "log": "{name}在{target}墳前哭了一場，回家後日子照過。",
       "effects": [{"ease_concern": {"kind": "grief", "by": 8}}],
       "ai": {"base": 8, "traits": {"content": 6}}}
     ]},

    {"id": "grief_at_home", "title": "家裡的傷心人", "scope": "player_head", "chance": 0.8, "cooldown_months": 6,
     "on": {"signal": "concern:grief", "as": "head", "after_months": [1, 3]},
     "conditions": {"target": {"concern": {"kind": "grief", "min": 25}, "age": [8, 120]}},
     "target": {"conditions": {"same_household": true}},
     // Told by who is grieving (a widow, a child, the old), else another way each time (fun-r8: six times the same words).
     "prompt": "這幾個月，{target_first}常一個人坐在{target_about:grief}的墳邊，飯也吃得很少。",
     "prompts": ["這幾個月，{target_first}常一個人坐在{target_about:grief}的墳邊，飯也吃得很少。",
                 "{target_first}這陣子做什麼都提不起勁，鋤頭拿起來又放下，一站就是半天。家裡人知道，{target_pron}還在想{target_about:grief}。",
                 "夜裡{name}聽見{target_first}在草墊上翻來覆去。天亮了，{target_pron}眼睛是腫的，什麼也不說，又出門往教堂墓地那邊去了。",
                 "{target_first}把{target_about:grief}用過的木碗擺在桌上，吃飯時誰也不准動。家裡人看在眼裡，誰也不敢開口。"],
     "prompt_if": [
       {"cond": {"target": {"recently_widowed": true}}, "prompt": "{target_first}還是天天往{target_about:grief}的墳前跑，回來就坐在門檻上，誰叫也不應。床的另一半空著，{target_pron}寧可睡在灶邊。"},
       {"cond": {"target": {"age": [8, 13]}}, "prompt": "{target_first}不肯再跟別的孩子去河邊玩了，夜裡常常哭醒，嘴裡喊著{target_about:grief}。"},
       {"cond": {"target": {"age": [60, 120]}}, "prompt": "{target_first}這陣子一下子老了好多，坐在門口曬太陽時常唸：「該走的是我，怎麼輪到{target_about:grief}。」"}
     ],
     "options": [
      {"text": "陪{target_pron}去墳前坐一下午，家裡傷心的人也一起去（佔一段空閒）",
       "log": ["{name}放下手上的活，帶著家裡的人，陪{target_first}在{target_about:grief}的墳前坐了一下午。",
               "{name}陪{target_first}去墳前拔了草，一家人坐在那裡，說了好多{target_about:grief}從前的事，說著說著倒笑了。"],
       "effects": [{"spend_time": 1}, {"on_target": [{"ease_concern": {"kind": "grief", "by": 25}}, {"stress": -8}]}, {"ease_concern_house": {"kind": "grief", "by": 12}}, {"mutual_opinion": {"value": 10, "mod": "comforted", "years": 12}}],
       "ai": {"base": 10, "traits": {"kind": 8, "gregarious": 3}}},
      {"text": "叫{target_pron}振作起來，日子還得過（不花時間，{target_first}會記著這句話）",
       "log": "{name}對{target_first}說：「人死不能復生，日子還得過。」{target_first}沒有回答。",
       "effects": [{"on_target": [{"ease_concern": {"kind": "grief", "by": 6}}, {"opinion": {"value": -6, "mod": "hard_words", "years": 8}}]}],
       "ai": {"base": 6, "traits": {"cruel": 6, "diligent": 3, "calm": 2}}},
      {"text": "請神父來家裡跟{target_pron}說說話（2 便士）",
       "log": "{name}請神父來家裡，神父陪{target_first}禱告了一個晚上。",
       "effects": [{"money": -2}, {"on_target": [{"ease_concern": {"kind": "grief", "by": 18}}, {"need": {"spirit": 35}}]}, {"target_opinion": {"value": 4, "mod": "comforted", "years": 8}}],
       "ai": {"base": 6, "traits": {"pious": 8}}},
      // Someone else in the house who is good at this: the head need not give a day, but the spouse gives the fields some.
      {"text": "讓{spouse}這陣子多陪陪{target_pron}（你不用分身；{spouse}田裡的活要少做些）",
       "conditions": {"is_spouse": false, "spouse": {"any": [{"trait": "kind"}, {"trait": "gregarious"}, {"trait": "pious"}]}},
       "log": "{name}託{spouse}多照看{target_first}。那陣子{target_first}走到哪裡，{spouse}就跟到哪裡，有時兩人在井邊一坐就是一下午。",
       "effects": [{"on_target": [{"ease_concern": {"kind": "grief", "by": 18}}, {"stress": -5}]}, {"work_bonus": -0.01}],
       "ai": {"base": 7, "traits": {"lazy": 3, "diligent": -2}}},
      // Work as the cure: the house gains a pair of hands, the grief is only pushed down.
      {"text": "把{target_about:grief}留下的那份活交給{target_pron}，讓{target_pron}忙起來（家裡多一把力，可心事是壓下去的）",
       "conditions": {"target": {"age": [14, 70], "grief_about_age": [12, 120]}},
       "log": "{name}把{target_about:grief}從前管的那攤活交給了{target_first}。{target_first}從早忙到晚，累得沒力氣哭了。",
       "effects": [{"work_bonus": 0.01}, {"on_target": [{"ease_concern": {"kind": "grief", "by": 10}}, {"stress": 6}, {"skill": {"farming": 0.5}}]}],
       "ai": {"base": 6, "traits": {"diligent": 8, "ambitious": 3, "kind": -3}}},
      {"text": "帶{target_pron}去酒館坐坐，聽聽村裡的熱鬧（1 便士，佔一段空閒）",
       "conditions": {"money_ge": 1, "target": {"age": [16, 120]}},
       "log": "{name}拉著{target_first}去了酒館。鄰居們你一句我一句，{target_first}聽著聽著，總算端起了杯子。",
