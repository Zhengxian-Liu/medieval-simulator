          "else": [{"log": "  {target_first}搖搖頭走了。後來那塊地賣給了別家。"}, {"target_opinion": {"value": -6, "mod": "haggled", "years": 8}}]}}],
       "ai": {"base": 5, "traits": {"greedy": 10, "cruel": 4, "kind": -8}}},
      {"text": "不買地，叫家裡的人去幫{target_pron}家把這一季的活做完（佔一段空閒，自家田裡少幾天工；{target_first}欠你一份情）",
       "log": "{name}沒提地的事，帶著家裡的人去{target}家，幫著把這一季的活做完了。",
       "effects": [{"spend_time": 1}, {"work_bonus": -0.01}, {"deed": {"type": "kindness"}}, {"target_owes_favour": {"weight": 8, "why": "喪事後幫他家把一季的活做完"}}, {"mutual_opinion": {"value": 6, "mod": "helped_them", "years": 10}}],
       "ai": {"base": 6, "traits": {"kind": 8, "generous": 6, "greedy": -6}}},
      {"text": "不在這時候談地（什麼也不花，{target_first}心裡敬你一分）",
       "log": "{name}說：「這種時候不談這個。」{target_first}點點頭，沒再開口。",
       "effects": [{"target_opinion": {"value": 4, "mod": "respect", "years": 6}}],
       "ai": {"base": 5, "traits": {"pious": 4, "content": 4, "shy": 3}}}
     ]},

