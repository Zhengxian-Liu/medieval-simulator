{
  // Secrets as leverage, and secrets that come home. "blackmail_terms" and "make_amends" are run by
  // code (the blackmail plan, a deathbed confession); the others listen to belief signals.
  "events": [
    {"id": "blackmail_terms", "title": "把柄", "prompt": "{name} 提起 {hook}，{target} 臉色發白。現在要什麼，由 {name} 說了算。", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "options": [
       {"text": "要錢", "log": "{name} 提起 {hook}，{target} 臉色發白，答應拿錢封口。",
        "effects": [{"hook_payment": 50}, {"deed": {"type": "blackmailed"}}, {"use_hook": true}],
        "ai": {"base": 8, "traits": {"greedy": 10, "generous": -6}}},
       {"text": "要地", "conditions": {"target": {"acres_ge": 12}},
        "log": "{name} 提起 {hook}，{target} 只好把河邊的 3 畝地「便宜」賣給了{pron}。",
        "effects": [{"take_acres": {"acres": 3, "price": 15, "wanted": false}}, {"deed": {"type": "blackmailed"}}, {"use_hook": true}],
        "ai": {"base": 6, "traits": {"ambitious": 8, "greedy": 4}}},
       {"text": "要一門親事", "conditions": {"peace_match": true},
        "log": "{name} 提起 {hook}，{target} 只能點頭，答應把家裡的孩子許給 {name} 家。",
        "effects": [{"peace_marriage": true}, {"deed": {"type": "blackmailed"}}, {"use_hook": true}],
        "ai": {"base": 4, "traits": {"ambitious": 8, "lustful": 2}}},
       {"text": "要他家別再找麻煩", "conditions": {"feud_ge": 1},
        "log": "{name} 提起 {hook}，{target} 沉默了很久，答應兩家的事從此一筆勾銷。",
        "effects": [{"end_feud": "對方的把柄在手上"}, {"use_hook": true}],
        "ai": {"base": 6, "traits": {"calm": 6, "content": 4, "forgiving": 4}}}
     ]},

    {"id": "blackmail_refused", "title": "敲竹槓不成", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "options": [
       {"text": "好", "log": "{target} 不吃這一套，一把揪住 {name} 的衣領拖到村口，大聲嚷嚷：「大家來聽聽，{name} 想拿閒話敲我的竹槓！」",
        "effects": [{"deed": {"type": "exposed_plot"}}, {"reputation": -5}, {"stress": 12}]}
     ]},

    {"id": "someone_knows", "title": "有人知道", "prompt": "{name} 察覺 {target} 看{pron}的眼神不對勁。{deed_year} 年那次「{deed}」的事，{target_pron}好像知道了。", "scope": "player_family", "chance": 0.7,
     "on": {"signal": "belief", "as": "culprit", "after_months": [1, 4]},
     "conditions": {"age": [14, 90], "deed_actor": true, "not": {"deed_noted": "someone_knows"}},
     "target": {"conditions": {"other_dynasty": true, "not_kin": true, "is_lover": false}},
     "options": [
       {"text": "塞錢封口", "conditions": {"money_ge": 15},
        "log": "{name} 察覺 {target} 知道了 {deed_year} 年那次「{deed}」的事，偷偷塞了錢給{target_pron}，求{target_pron}別說出去。",
        "effects": [{"note_deed": "someone_knows"}, {"hush_money": {"base": 15}}, {"silence_target": {"years": 6}}, {"deed": {"type": "hush_money"}}, {"signal": "hushed"}],
        "ai": {"base": 8, "traits": {"craven": 6, "generous": 4, "greedy": -6}}},
       {"text": "先下手，說他的閒話", "log": "{name} 察覺 {target} 知道了 {deed_year} 年那次「{deed}」的事，搶先在井邊說{target_pron}滿嘴謊話、手腳不乾淨。",
        "effects": [{"note_deed": "someone_knows"}, {"deed": {"type": "slander"}}, {"target": [{"reputation": -4}]}],
        "ai": {"base": 5, "traits": {"cruel": 10, "ambitious": 4, "wrathful": 4, "kind": -8}}},
       {"text": "向神父告解", "log": "{name} 察覺 {target} 知道了 {deed_year} 年那次「{deed}」的事，夜裡睡不著，去向神父告解。",
        "effects": [{"note_deed": "someone_knows"}, {"confess_secrets": "priest"}, {"stress": -20}, {"need": {"spirit": 20}}],
        "ai": {"base": 4, "traits": {"pious": 14, "cynical": -8}}},
       {"text": "裝作沒事", "log": "{name} 察覺 {target} 看{pron}的眼神不對勁。{deed_year} 年那次「{deed}」的事，難道有人知道了？",
        "effects": [{"note_deed": "someone_knows"}, {"stress": 12}],
        "ai": {"base": 6, "traits": {"calm": 6, "brave": 4}}}
     ]},

    {"id": "witness_returns", "title": "又找上門", "prompt": "收過封口費的 {target} 又找上門來，說最近手頭緊。{deed_year} 年那件事還攥在{target_pron}手裡。", "scope": "anyone", "chance": 0.45,
     "on": {"signal": "hushed", "after_months": [12, 48]},
     "conditions": {"age": [14, 90]},
     "options": [
       {"text": "再給一次", "conditions": {"money_ge": 10},
        "log": "收過封口費的 {target} 又找上門來，說最近手頭緊。{name} 知道{target_pron}要的是什麼，{deed_year} 年那件事還攥在{target_pron}手裡。",
        "effects": [{"hush_money": {"base": 12}}, {"silence_target": {"years": 6}}, {"stress": 10}, {"signal": "hushed"}],
        "ai": {"base": 8, "traits": {"craven": 8, "calm": 2, "brave": -6, "wrathful": -4}}},
       {"text": "不給了，隨他去說",
        "log": "收過封口費的 {target} 又來要錢，{name} 把{target_pron}轟了出去。沒過幾天，{deed_year} 年那次「{deed}」的事就傳到了苦主家裡。",
        "effects": [{"tell_victim": true}, {"stress": 6}],
        "ai": {"base": 5, "traits": {"brave": 8, "greedy": 6, "content": 3, "craven": -8}}},
       {"text": "反過來嚇唬他",
        "log": "收過封口費的 {target} 又來要錢，{name} 抄起一把柴刀，說再來就讓{target_pron}好看。",
        "effects": [{"random": {"percent": 50,
                                "effects": [{"silence_target": {"years": 15}}, {"log": "  {target} 臉都白了，再也沒提過那件事。"}],
                                "else": [{"tell_victim": true}, {"deed": {"type": "public_insult"}}, {"log": "  {target} 嚇得跑了，轉頭就把那件事全說了出去。"}]}}],
        "ai": {"base": 3, "traits": {"wrathful": 10, "cruel": 8, "brave": 6, "kind": -6, "craven": -10}}}
     ]},

    {"id": "wrongly_suspected", "title": "背後的指點", "prompt": "{name} 聽說 {target} 到處說 {deed_year} 年那次「{deed}」是{pron}幹的。", "scope": "player_family", "chance": 0.6,
     "on": {"signal": "belief", "as": "culprit", "after_months": [1, 6]},
     "conditions": {"age": [14, 90], "deed_actor": false, "not": {"deed_noted": "wrongly_suspected"}},
     "target": {"conditions": {"other_dynasty": true, "not_kin": true}},
     "options": [
       {"text": "上門說清楚", "log": "{name} 聽說 {target} 認定 {deed_year} 年那次「{deed}」是{pron}幹的，氣得上門去理論。",
        "effects": [{"note_deed": "wrongly_suspected"}, {"random": {"percent": 40, "effects": [{"note_deed": "wrongly_suspected"}, {"clear_suspicion": {"to": 20}}, {"log": "  說了半天，{target} 總算半信半疑地鬆了口。"}],
                                "else": [{"deed": {"type": "public_insult", "doer": "target"}}, {"log": "  {target} 根本不聽，當著鄰居的面把{pron}罵了出來。"}]}}],
        "ai": {"base": 8, "traits": {"brave": 6, "wrathful": 6, "gregarious": 4, "shy": -6}}},
       {"text": "請神父作證", "conditions": {"trait": "pious"},
        "log": "{name} 被 {target} 冤枉是 {deed_year} 年那次「{deed}」的主使，請神父出面替{pron}的為人作保。",
        "effects": [{"note_deed": "wrongly_suspected"}, {"clear_suspicion": {"to": 30}}, {"need": {"spirit": 10}}],
        "ai": {"base": 8}},
       {"text": "由他去說", "log": "{name} 聽說 {target} 到處說 {deed_year} 年那次「{deed}」是{pron}幹的，咬著牙不理會。",
        "effects": [{"note_deed": "wrongly_suspected"}, {"stress": 10}],
        "ai": {"base": 6, "traits": {"calm": 8, "content": 4, "craven": 4}}}
     ]},

    {"id": "make_amends", "title": "錯怪", "prompt": "{name} 終於知道，這些年錯怪了 {target}。", "scope": "player_head", "chance": 1,
     "on": {"signal": "manual"},
     "conditions": {"age": [14, 120]},
     "options": [
       {"text": "上門賠罪", "log": "{name} 帶著一壺麥酒去 {target} 家，為這些年的錯怪賠罪。",
        "effects": [{"deed": {"type": "made_amends"}}, {"end_feud": "上門賠罪"}],
        "ai": {"base": 8, "traits": {"kind": 8, "forgiving": 8, "pious": 6, "ambitious": -2}}},
       {"text": "拉不下臉", "log": "{name} 知道錯怪了 {target}，卻怎麼也拉不下臉去道歉。",
        "effects": [{"stress": 8}],
        "ai": {"base": 5, "traits": {"vengeful": 8, "cruel": 6, "shy": 4}}}
     ]},

    {"id": "old_flame", "title": "舊事", "prompt": "{target} 在教堂門口和{deed_actor}說了幾句話，{deed_actor}低著頭快步走開了。{deed_year} 年{deed_actor}和{target_first}的事，你知道，一直沒說破。",
     "scope": "player_head", "chance": 1,
     "on": {"signal": "manual"},
     "options": [
       {"text": "回家跟{deed_actor}挑明", "log": "那天晚上，{name} 關上門對{deed_actor}說：「{deed_year} 年你和{target_first}的事，我都知道。」",
        "effects": [{"end_affair": true}, {"note_deed": "spoken"}, {"on_deed_actor": [{"stress": 12}]},
                    {"random": {"percent": 50,
                                "effects": [{"log": "  {deed_actor}哭著求你原諒，兩人說了一夜的話。"}, {"on_deed_actor": [{"opinion": {"value": 6, "mod": "made_up", "years": 8}}]}, {"stress": -10}],
                                "else": [{"log": "  {deed_actor}一句話也沒說。從那天起，兩人之間像隔了一道牆。"}, {"on_deed_actor": [{"opinion": {"value": -12, "mod": "hard_words", "years": 10}}]}, {"stress": 6}]}}],
        "ai": {"base": 8, "traits": {"brave": 4, "wrathful": 4}}},
       {"text": "去找{target_first}，叫{target_pron}離我家的人遠一點", "log": "{name} 在路上攔住 {target}：「{deed_year} 年的事我知道。離我家的人遠一點。」",
        "effects": [{"end_affair": true}, {"note_deed": "spoken"}, {"mutual_opinion": {"value": -15, "mod": "hard_words", "years": 10}},
                    {"random": {"percent": 50,
                                "effects": [{"log": "  {target_first}漲紅了臉，一句也沒辯，轉身走了。"}, {"stress": -6}],
                                "else": [{"log": "  {target_first}冷笑：「管不住自家的人，倒來找我？」這話第二天就傳遍了村子。"}, {"deed": {"type": "public_insult", "doer": "target"}}, {"stress": 8}]}}],
        "ai": {"base": 6, "traits": {"wrathful": 8, "brave": 6, "craven": -6}}},
       {"text": "拿這件事壓{target_first}", "conditions": {"target": {"married": true}},
        "log": "{name} 把 {target} 叫到一邊：「{deed_year} 年的事，你也不想讓你家裡人知道吧？」",
        "effects": [{"log": "  {target_first}臉色發白。"}, {"hook_payment": 40}, {"target_opinion": {"value": -20, "mod": "pressed_with_secret", "years": 12}}, {"end_affair": true}, {"note_deed": "spoken"}],
        "ai": {"base": 4, "traits": {"greedy": 8, "cruel": 6, "kind": -6}}},
       {"text": "就當不知道", "log": "{name} 看著{deed_actor}走遠，什麼也沒說。",
        "effects": [{"stress": 8}],
        "ai": {"base": 6, "traits": {"calm": 6, "shy": 6, "forgiving": 4}}}
     ]},

    {"id": "old_wrong", "title": "那件事", "prompt": "{target} 在磨坊前跟你打招呼，笑得跟沒事一樣。{deed_year} 年那次「{deed}」，你知道是{target_pron}幹的。",
     "scope": "player_head", "chance": 1,
     "on": {"signal": "manual"},
     "options": [
       {"text": "告到莊園法庭", "conditions": {"deed_tried": false},
        "log": "{name} 在莊園法庭上指著 {target}，說出 {deed_year} 年那次「{deed}」的事。",
        "effects": [{"accuse": true}],
        "ai": {"base": 6, "traits": {"brave": 6, "vengeful": 6, "craven": -4}}},
       {"text": "私下找{target_pron}，要{target_pron}賠", "log": "{name} 把 {target} 堵在門口：「{deed_year} 年的事，你自己清楚。賠錢，這事就算了。」",
        "effects": [{"hook_payment": {"amount": 40, "label": "賠償"}}, {"use_hook": true}, {"note_deed": "spoken"}, {"target_opinion": {"value": -15, "mod": "pressed_with_secret", "years": 10}}],
        "ai": {"base": 6, "traits": {"greedy": 8, "calm": 2}}},
       {"text": "在井邊把這件事說出去", "log": "{name} 在井邊把 {deed_year} 年那次「{deed}」的來龍去脈說了出來，說是 {target} 幹的。",
        "effects": [{"target": [{"reputation": -6}]}, {"note_deed": "spoken"}, {"mutual_opinion": {"value": -20, "mod": "hard_words", "years": 12}}, {"deed": {"type": "public_insult"}}],
        "ai": {"base": 4, "traits": {"wrathful": 6, "gregarious": 6, "vengeful": 6}}},
       {"text": "算了，都過去這麼多年了", "log": "{name} 點了點頭，走了過去。那件事就讓它過去吧。",
        "effects": [{"stress": 4}],
        "ai": {"base": 6, "traits": {"forgiving": 10, "calm": 6, "content": 4, "vengeful": -10}}}
     ]},

    // Found out (a belief strong enough to act on), or caught at it by the head (hooks.cpp familyAffairs runs it at
    // once): what to do about a husband's or wife's affair. Once per affair ("confronted").
    {"id": "spouse_learns_affair", "title": "枕邊的背叛", "prompt": "{name} 知道了 {target} 背著{pron}和 {deed_with} 好過。", "scope": "anyone", "chance": 0.85,
     "prompt_if": [{"cond": {"deed_with_lord": true}, "prompt": "{target}和領主 {deed_with} 的事，{name} 這回知道得清清楚楚。對方是老爺，你家的地還捏在他手裡。"}],
     "on": {"signal": "belief", "deed_type": "affair", "victim_side": true, "after_months": [0, 2]},
     "conditions": {"married": true, "age": [16, 80], "not": {"deed_noted": "confronted"}},
     "target": {"conditions": {"is_spouse": true}},
     "options": [
       {"text": "關起門來跟{target_pron}對質，叫{target_pron}斷了", "log": "{name} 關上門跟 {target} 對質。{target_first}哭了，說往後再也不見 {deed_with}。",
        "logs": ["{name} 關上門跟 {target} 對質。{target_first}哭了，說往後再也不見 {deed_with}。",
                 "{name} 關上門跟 {target} 對質，兩人吵到半夜。第二天起，{target_first}再也沒往 {deed_with} 那邊去。"],
        "effects": [{"note_deed": "confronted"}, {"end_affair": true}, {"mutual_opinion": {"value": -20, "mod": "betrayed", "back_mod": "found_out", "years": 12}}, {"note_deed": "spoken"}, {"stress": 8}],
        "ai": {"base": 8, "traits": {"wrathful": 6, "brave": 4, "calm": 2, "craven": -4}}},
       {"text": "告到教會法庭，讓兩人當眾悔罪", "log": "{name} 把 {target} 和 {deed_with} 告到教會法庭，罪名是私通。",
        "effects": [{"note_deed": "confronted"}, {"expose_affair": true}, {"opinion": {"value": -30, "mod": "betrayed", "years": 20}}, {"reputation": -2}],
        "ai": {"base": 3, "traits": {"vengeful": 10, "pious": 6, "cruel": 4, "kind": -6}, "if": [{"cond": {"deed_with_lord": true}, "add": -3}]}},
       {"text": "去找 {deed_with} 打一架", "conditions": {"deed_with_here": true, "sex": "male"},
        "log": "{name} 在磨坊前截住 {deed_with}，一拳打了過去。圍過來的人都看見了。",
        "effects": [{"note_deed": "confronted"}, {"fight_lover": true}, {"opinion": {"value": -15, "mod": "betrayed", "years": 12}}, {"stress": -6}],
        "ai": {"base": 4, "traits": {"wrathful": 10, "brave": 8, "strong": 4, "craven": -10, "calm": -6}, "if": [{"cond": {"deed_with_lord": true}, "add": -3}]}},
       {"text": "忍下來，什麼也不說", "log": "{name} 知道了 {target} 背著{pron}和別人好過，從此再也沒有正眼看過{target_pron}。",
        "effects": [{"note_deed": "confronted"}, {"opinion": {"value": -20, "mod": "betrayed", "years": 15}}, {"stress": 20}],
        "ai": {"base": 6, "traits": {"shy": 8, "calm": 6, "melancholy": 6, "craven": 4}, "if": [{"cond": {"deed_with_lord": true}, "add": 6}]}}
     ]},

    // The second stage of a family member's affair reaching the head (hooks.cpp familyAffairs): a neighbour, {target},
    // drops a plainer hint. Watching finds it soonest; pressing the neighbour makes it likelier; letting it go, least.
    {"id": "affair_hint", "title": "鄰居的話", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "prompt": "{target} 在井邊跟{name}說話，說著說著壓低了聲音：「{deed_actor}這陣子常往 {deed_with} 那邊走，天黑了才回來……我可什麼都沒說。」",
     "options": [
       {"text": "把{target_pron}拉到一邊，問清楚看見了什麼", "log": "{name} 把 {target} 拉到一邊追問。{target_first}支支吾吾，只說好幾回看見{deed_actor}和 {deed_with} 在一塊。",
        "effects": [{"note_deed": "asked"}, {"suspect": 15}, {"stress": 6}],
        "ai": {"base": 8, "traits": {"brave": 4, "wrathful": 4, "gregarious": 3}}},
       {"text": "閒話而已，不理", "log": "{target} 話裡有話，{name} 只當沒聽懂。",
        "effects": [],
        "ai": {"base": 6, "traits": {"calm": 6, "content": 4, "forgiving": 4}}},
       {"text": "不動聲色，暗中盯著{deed_actor}", "log": "{name} 什麼也沒說。從那天起，暗中留意{deed_actor}每天往哪裡去。",
        "effects": [{"note_deed": "watched"}, {"stress": 4}],
        "ai": {"base": 6, "traits": {"clever": 6, "vengeful": 4, "cynical": 4}}}
     ]},

    // A child born while the mother had a lover grows up looking like someone else (hooks.cpp familyAffairs).
    {"id": "not_like_you", "title": "長得不像你", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "prompt": "{target_first}一天天長大，眉眼卻一點也不像{name}。在教堂裡，有人看看{target_first}，又看看別處，交頭接耳。",
     "options": [
       {"text": "{target_first}就是我的孩子，誰也別多嘴", "log": "有人在教堂門口說{target_first}長得不像爹，{name} 把話頂了回去：「{target_first}是我的孩子。」",
        "effects": [{"target_opinion": {"value": 8, "mod": "stood_by", "years": 12}}, {"stress": 4}],
        "ai": {"base": 8, "traits": {"kind": 8, "forgiving": 6, "calm": 4, "vengeful": -6}}},
       {"text": "心裡起了疙瘩，對{target_pron}冷了下來", "log": "{name} 嘴上沒說，看{target_first}的眼神卻冷了。",
        "effects": [{"opinion": {"value": -25, "mod": "doubted_paternity", "years": 20}}, {"target_opinion": {"value": -10, "mod": "cold_father", "years": 15}}, {"stress": 8}],
        "ai": {"base": 6, "traits": {"vengeful": 4, "melancholy": 4, "cynical": 6}}},
       {"text": "不認{target_pron}，家業不傳給{target_pron}", "conditions": {"target": {"sex": "male", "age": [0, 15]}},
        "log": "{name} 當著家裡人的面說：{target_first}不是我的種，這個家將來沒{target_pron}的份。",
        "effects": [{"disown_target": true}, {"opinion": {"value": -40, "mod": "doubted_paternity", "years": 30}}, {"target_opinion": {"value": -30, "mod": "cold_father", "years": 25}},
                    {"household_opinion": {"value": -8, "mod": "hard_words", "years": 8}}, {"reputation": -2}],
        "ai": {"base": 1, "traits": {"cruel": 8, "vengeful": 6, "wrathful": 4, "kind": -8}}}
     ]},

    // Gossip that gives the head something to do (design/stitching-fable.md): ask, warn, spread, or let it be. The one
    // talked about has something to hide; what is learned over a pot of ale is a hold over them (把柄).
    {"id": "village_gossip", "title": "閒話", "scope": "player_head", "chance": 0.012, "cooldown_years": 3,
