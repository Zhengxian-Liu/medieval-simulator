    {"id": "talk_teach_letters", "title": "教認字", "scope": "interaction", "cooldown_months": 3,
     "interaction": {"who": "household", "time": 1, "desc": "晚上在灶邊用木炭在石板上教{pron}認字（學會了就是識字的人）"},
     "conditions": {"age": [6, 16], "no_trait": "literate", "target": {"trait": "literate"}, "not": {"trait": "dull"}},
