       "ai": {"base": 6, "traits": {"generous":  8, "kind":  6, "gregarious":  2, "greedy":  -8}, "if": [{"cond": {"opinion_of_target_ge": 35}, "add": 10}, {"cond": {"lean": true}, "add": -12}]}},
      {"text": "推說自家也不夠吃",
