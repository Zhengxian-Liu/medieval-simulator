        "ai": {"base": 6, "traits": {"ambitious": 8, "generous": 4, "greedy": -8}}},
       {"text": "借給莊園 200 便士（秋後收了租分兩年還，連本帶利 220）", "conditions": {"money_ge": 200},
        "log": "{name} 借了 200 便士給莊園，管家在帳上寫明：連本帶利 220 便士，米迦勒節收了租以後分兩年還清。",
        "effects": [{"money": -200}, {"target": [{"owe_target": 220}]}, {"target_opinion": {"value": 10, "mod": "helped_the_manor", "years": 10}}],
        "ai": {"base": 5, "traits": {"greedy": 4, "ambitious": 4, "craven": 2}}},
       {"text": "推說手頭拿不出來", "log": "{name} 推說手頭拿不出錢。管家看了看 {name} 家新修的籬笆，沒說什麼。",
        "effects": [{"target_opinion": {"value": -8, "mod": "held_back", "years": 8}}],
        "ai": {"base": 6, "traits": {"greedy": 8, "content": 4, "ambitious": -4}}}
     ]}
    ,
    {"id": "lay_subsidy", "title": "國王的稅", "prompt": "國會准了國王一筆稅，照家當交十五分之一。村裡推了 {target} 和另一個殷實人家挨家估稅，翻過你家的錢箱、糧倉和牲口棚，算下來該交 {tax} 便士。",
     "scope": "anyone", "chance": 1, "on": {"signal": "manual"},
     "conditions": {},
