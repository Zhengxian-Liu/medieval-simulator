            "else": [{"log": "  估稅的在屋裡轉了一圈，沒看出什麼。"}]}}],
        "ai": {"base": 4, "traits": {"greedy": 10, "brave": 4, "pious": -6, "craven": -6}}},
       {"text": "塞給 {target_first} 10 便士，請他少算三成",
        "log": "{name} 把 10 便士塞進 {target} 的袖子裡，估出來的家當少了三成。",
        "effects": [{"pay_tax": 0.7}, {"money": -10}, {"target": [{"money": 10}]}, {"deed": {"type": "bribed_assessor"}}],
        "ai": {"base": 4, "traits": {"greedy": 6, "cynical": 6, "pious": -6}}}
