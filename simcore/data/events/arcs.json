{
  // Story arcs: debt and family feuds. The debt events are run by the rent-day code
  // ("signal": "manual" keeps them off the monthly pulse); the feud events need a feud between
  // the two families at the stage given in "min_stage" (1 嫌隙, 2 結怨, 3 世仇).
  "events": [
    {"id": "debt_steward", "title": "催租", "prompt": "管家上門來催 {debt} 便士的欠租。", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "conditions": {"is_head": true, "in_debt": true},
     "options": [
       {"text": "把 {debt} 便士一次還清", "conditions": {"money_covers_debt": true}, "log": "管家上門來催 {debt} 便士的欠租，{name} 當場數錢還清了。",
        "effects": [{"pay_off_debt": true}, {"stress": -5}], "ai": {"base": 12, "traits": {"diligent": 4, "greedy": -4}}},
       {"text": "求管家寬限一年", "log": "管家上門來催 {debt} 便士的欠租，{name} 求他寬限到明年秋收。",
        "effects": [{"stress": 8}, {"random": {"percent": 55, "effects": [{"debt_grace": true}, {"log": "  管家答應了，臉色卻很難看。"}],
                                               "else": [{"reputation": -2}, {"log": "  管家冷笑一聲：「明年再交不出，就別怪我牽牛。」"}]}}],
        "ai": {"base": 8, "traits": {"gregarious": 4, "craven": 4, "content": 3}}},
       {"text": "賣掉耕牛", "conditions": {"no_ox": false},
        "log": "管家上門來催 {debt} 便士的欠租。{name} 把耕牛牽到市集賣了，明年只能跟人借牲口犁地。",
        "effects": [{"sell_ox": true}, {"stress": 6}],
        "ai": {"base": 6, "traits": {"diligent": 4, "brave": 2, "greedy": -4}}},
       {"text": "退回幾畝地給領主抵債", "conditions": {"customary_ge": 6},
        "log": "管家上門來催 {debt} 便士的欠租。{name} 咬咬牙，把幾畝地交回給領主抵債。",
        "effects": [{"surrender_acres": "debt"}, {"stress": 8}],
        "ai": {"base": 3, "traits": {"content": 4, "ambitious": -6}}},
       {"text": "讓孩子去莊園幹活抵債", "conditions": {"service_child": true},
        "log": "管家上門來催 {debt} 便士的欠租。{name} 答應讓家裡的孩子去幹活抵債。",
        "effects": [{"service_for_debt": {"years": 3, "value": 35}}],
        "ai": {"base": 6, "traits": {"cruel": 4, "greedy": 4, "kind": -4}}},
       {"text": "向鄰居借錢", "conditions": {"has_lender": true},
        "log": "管家上門來催 {debt} 便士的欠租，{name} 拉下臉去找鄰居借錢。",
        "effects": [{"borrow": true}],
        "ai": {"base": 7, "traits": {"gregarious": 5, "shy": -5, "ambitious": 2}}},
       {"text": "拖著不管", "log": "管家上門來催 {debt} 便士的欠租，{name} 把他打發走了，心想船到橋頭自然直。",
        "effects": [{"stress": 4}],
        "ai": {"base": 3, "traits": {"lazy": 8, "content": 4, "diligent": -6}}}
     ]},

    {"id": "debt_neighbour", "title": "討債", "prompt": "{target} 上門來討 {debt} 便士的債，說好的日子已經過了。", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "conditions": {"is_head": true, "in_debt": true},
     "options": [
       {"text": "把 {debt} 便士一次還清", "conditions": {"money_covers_debt": true}, "log": "{target} 上門來討 {debt} 便士的債，{name} 當場數錢還清了。",
        "effects": [{"pay_off_debt": true}, {"target_opinion": {"value": 4, "mod": "paid_up", "years": 5}}], "ai": {"base": 12, "traits": {"diligent": 4, "greedy": -4}}},
       {"text": "求對方寬限", "log": "{target} 上門來討 {debt} 便士的債，{name} 求{target_pron}再寬限一年。",
        "effects": [{"stress": 8}, {"random": {"percent": 50, "effects": [{"debt_grace": true}, {"log": "  {target} 嘆了口氣，答應了。"}],
                                               "else": [{"feud_heat": 8}, {"log": "  {target} 撂下話：「明年再還不上，我們法庭上見。」"}]}}],
        "ai": {"base": 8, "traits": {"gregarious": 3, "craven": 4}}},
       {"text": "賣牛還債", "conditions": {"no_ox": false},
        "log": "{target} 上門來討 {debt} 便士的債，{name} 只好把耕牛賣了還錢。",
        "effects": [{"sell_ox": true}, {"stress": 6}],
        "ai": {"base": 6, "traits": {"diligent": 4, "greedy": -4}}},
       {"text": "讓孩子去對方家幹活", "conditions": {"service_child": true},
        "log": "{target} 上門來討 {debt} 便士的債，{name} 讓家裡的孩子去{target_pron}家幹活抵債。",
        "effects": [{"service_for_debt": {"years": 3, "value": 35}}],
        "ai": {"base": 5, "traits": {"cruel": 4, "greedy": 4, "kind": -4}}},
       {"text": "賴帳", "log": "{target} 上門來討 {debt} 便士的債，{name} 一口咬定早就還過了。",
        "effects": [{"feud_heat": 18}, {"reputation": -3}, {"target_opinion": {"value": -25, "mod": "welched", "years": 15}}],
        "ai": {"base": 2, "traits": {"cruel": 8, "greedy": 8, "kind": -6, "pious": -4}}}
     ]},

    {"id": "debt_reckoning", "title": "算總帳", "prompt": "這筆 {debt} 便士的債已經拖了三年。管家說今年不能再拖了，莊園法庭要個了斷。", "scope": "anyone", "chance": 1,
     "on": {"signal": "manual"},
     "conditions": {"is_head": true, "in_debt": true},
     "options": [
       {"text": "交出幾畝地抵債", "conditions": {"acres_ge": 12},
        "log": "欠了三年的 {debt} 便士，管家說今年不能再拖了。{name} 在莊園法庭上低著頭，聽著要收回哪幾條地。",
        "effects": [{"forfeit_land": true}],
        "ai": {"base": 6, "traits": {"calm": 4, "content": 4, "ambitious": -4}}},
       {"text": "替莊園服三年勞役抵債",
        "log": "欠了三年的 {debt} 便士，{name} 答應接下來三年每週多替領主幹兩天活，自家的地只好少顧一些。",
        "effects": [{"boon_for_debt": 3}, {"lord_opinion": {"value": 4, "mod": "worked_off_debt", "years": 6}}, {"need": {"rest": -20}}],
        "ai": {"base": 7, "traits": {"diligent": 10, "craven": 4, "lazy": -10}}},
       {"text": "收個房客", "conditions": {"lodger": false},
        "log": "欠了三年的 {debt} 便士，{name} 讓一個外村來的幫工住進了爐邊的角落，房錢先拿去還了一半的債。",
        "effects": [{"take_lodger": 5}, {"stress": 5}],
        "ai": {"base": 6, "traits": {"gregarious": 6, "greedy": 4, "shy": -6}}},
       {"text": "把地交回去，當個茅舍農", "conditions": {"acres_ge": 4, "lean": true},
        "log": "欠了三年的 {debt} 便士，{name} 把整份地交還給莊園，只留下屋後的菜園。從此一家人靠給人打零工過日子。",
        "effects": [{"surrender_holding": true}, {"prestige": -2}, {"reputation": -2}, {"stress": 25}],
        "ai": {"base": 2, "traits": {"content": 6, "lazy": 4, "ambitious": -10}}},
       {"text": "去求領主開恩（免了的話，從此 10 年選不上莊頭）",
        "log": "欠了三年的 {debt} 便士，{name} 跪在 {target} 面前，求他免了這筆債。",
        "effects": [{"if": {"cond": {"flag": "lord_favour"},
                            "then": [{"deed": {"type": "forgiven_by_lord", "doer": "target"}}, {"clear_debt": true}, {"lords_debtor": 10}, {"reputation": -3},
                                     {"log": "  {target} 揮揮手免了。從此 {name} 見了領主家的人，腰都得彎得更低。"}],
                            "else": [{"random": {"percent": 35,
                                     "effects": [{"deed": {"type": "forgiven_by_lord", "doer": "target"}}, {"clear_debt": true}, {"lords_debtor": 10}, {"reputation": -3},
                                                 {"log": "  {target} 揮揮手免了。從此 {name} 見了領主家的人，腰都得彎得更低。"}],
                                     "else": [{"log": "  管家冷冷地說：「規矩就是規矩。」"},
                                              {"if": {"cond": {"acres_ge": 12}, "then": [{"forfeit_land": true}], "else": [{"boon_for_debt": 3}, {"log": "  {name} 只好答應替莊園服三年勞役。"}]}},
                                              {"stress": 10}]}}]}}],
        "ai": {"base": 5, "traits": {"craven": 6, "gregarious": 3, "brave": -4, "ambitious": -2}, "if": [{"cond": {"flag": "lord_favour"}, "add": 15}]}}
     ]},

    {"id": "rent_raised", "title": "加租", "prompt": "{target} 看 {name} 家這幾年日子過得不錯，管家傳話說要加租。", "scope": "anyone", "pulse": "yearly", "chance": 0.35, "cooldown_years": 6,
     "conditions": {"is_head": true, "money_ge": 500, "not": {"occupation": ["lord", "lady", "priest"]}},
     "target": {"pick": "lord", "conditions": {}},
     "options": [
       {"text": "認了", "log": "{target} 看 {name} 家日子過得好，把地租加了一成半。",
        "effects": [{"rent_factor": 0.15}, {"stress": 5}], "ai": {"base": 10, "traits": {"content": 4, "craven": 4}}},
       {"text": "送禮求情（30 便士）", "log": "{target} 想給 {name} 家加租，{name} 送了一頭肥豬到莊園，加租的事才緩了下來。",
        "effects": [{"money": -30}, {"rent_factor": 0.05}, {"target_opinion": {"value": 8, "mod": "fat_pig", "years": 5}}],
        "ai": {"base": 6, "traits": {"gregarious": 4, "ambitious": 4, "greedy": -6}}},
       {"text": "帶頭抗議", "log": "{target} 要給 {name} 家加租，{name} 帶著幾戶佃農到莊園門口抗議。",
        "effects": [{"random": {"percent": 35, "effects": [{"reputation": 3}, {"log": "  領主怕把事情鬧大，讓步了。"}],
                                "else": [{"rent_factor": 0.25}, {"target_opinion": {"value": -20, "mod": "agitator", "years": 15}},
                                         {"log": "  領主不但沒讓步，還把 {name} 家的租加得更重了。"}]}}],
        "ai": {"base": 3, "traits": {"brave": 10, "wrathful": 6, "ambitious": 3, "craven": -8, "content": -2, "shy": -2, "calm": -1, "pious": -1, "forgiving": -1}}}
     ]},

    {"id": "lord_reprisal", "title": "管家找麻煩", "prompt": "{target} 記著 {name} 的帳。管家上門來，說 {name} 家的租從今年起要加三成。", "scope": "player_head", "pulse": "yearly", "chance": 0.5, "cooldown_years": 3,
     "conditions": {"age": [14, 120], "lord_opinion_lt": -25, "not": {"occupation": ["lord", "lady", "priest"]}},
     "target": {"pick": "lord", "conditions": {}},
     "options": [
       {"text": "認了", "log": "{target} 記著 {name} 的帳。管家上門說，{name} 家的租從今年起要加三成。{name} 什麼也沒說。",
        "effects": [{"rent_factor": 0.3}, {"stress": 10}],
        "ai": {"base": 8, "traits": {"craven": 6, "content": 4, "calm": 4}}},
       {"text": "送禮賠罪（30 便士）", "conditions": {"money_ge": 30},
        "log": "{target} 記著 {name} 的帳，管家開始處處刁難。{name} 備了 30 便士和一隻鵝，到莊園門口站了一上午才見到人。",
        "effects": [{"money": -30}, {"lord_opinion": {"value": 20, "mod": "begged_pardon", "years": 8}}, {"reputation": -1}],
        "ai": {"base": 7, "traits": {"gregarious": 4, "ambitious": 4, "greedy": -6, "brave": -2}}},
       {"text": "頂回去", "log": "{target} 記著 {name} 的帳，管家來說要加租。{name} 當著鄰居的面說：「租是老規矩定的，要加，去法庭說。」",
        "effects": [{"random": {"percent": 35,
                                "effects": [{"reputation": 4}, {"log": "  管家沒料到一個佃農敢這樣說話，悻悻地走了。這件事在村裡傳了很久。"}],
                                "else": [{"rent_factor": 0.4}, {"deed": {"type": "public_insult", "doer": "target"}}, {"lord_opinion": {"value": -10, "mod": "insolent", "years": 10}},
                                         {"log": "  第二天管家帶著人來，當著全村的面把 {name} 罵得抬不起頭，租照加，還多加了一成。"}]}}],
        "ai": {"base": 3, "traits": {"brave": 10, "wrathful": 8, "ambitious": 3, "craven": -10}}}
     ]},

    {"id": "feud_mediation", "title": "神父調解", "prompt": "神父看不下去 {name} 家和 {target_house} 家的仇（從{feud_cause}起），請兩家家主到教堂門口來。", "scope": "player_head", "chance": 0.03, "cooldown_years": 4,
     "conditions": {"age": [14, 120], "is_head": true},
     "target": {"pick": "feud", "min_stage": 2, "conditions": {"is_head": true, "feud_truce": false}},
     "options": [
       {"text": "握手言和", "log": "神父看不下去 {name} 家和 {target_house} 家的仇（從{feud_cause}起），請兩家家主在教堂門口握手。{name} 伸出了手。",
        "effects": [{"deed": {"type": "mediated"}}],
        "ai": {"base": 6, "traits": {"pious": 10, "forgiving": 10, "kind": 6, "calm": 4, "vengeful": -10, "wrathful": -4}}},
       {"text": "要對方先賠錢", "log": "神父請 {name} 和 {target} 在教堂門口握手言和，{name} 說要{target_pron}家先賠錢。",
        "effects": [{"random": {"percent": 45,
                                "effects": [{"deed": {"type": "paid_compensation", "doer": "target"}}, {"money": 20}, {"target": [{"money": -20}]},
                                            {"log": "  {target} 咬著牙賠了 20 便士。"}],
                                "else": [{"feud_heat": 10}, {"log": "  {target} 不肯，兩家當著神父的面又吵了起來。"}]}}],
        "ai": {"base": 6, "traits": {"greedy": 8, "ambitious": 4, "vengeful": 4}}},
       {"text": "拒絕", "log": "神父想替 {name} 家和 {target_house} 家調解，{name} 轉身就走。",
        "effects": [{"feud_heat": 5}, {"reputation": -1}],
        "ai": {"base": 4, "traits": {"vengeful": 12, "wrathful": 8, "pious": -8}}}
     ]},

    {"id": "feud_peace_marriage", "title": "結親化仇", "prompt": "{target} 託人來說：兩家鬥了這麼多年，不如結門親。嫁娶的是兩家的孩子，記仇的是兩家的大人。", "scope": "player_head", "chance": 0.015, "cooldown_years": 8,
     "conditions": {"age": [14, 120], "is_head": true},
     "target": {"pick": "feud", "min_stage": 2, "conditions": {"is_head": true, "peace_match": true}},
     "options": [
       {"text": "答應",
        "log": "{target} 託人來說：兩家鬥了這麼多年，不如結門親。{name} 想了一夜，點了頭。",
        "effects": [{"peace_marriage": true}, {"prestige": 1}],
        "ai": {"base": 8, "traits": {"forgiving": 10, "kind": 6, "ambitious": 4, "vengeful": -10}}},
       {"text": "回絕", "log": "{target} 託人來說親，想化解兩家的仇。{name} 把媒人趕了出去。",
        "effects": [{"deed": {"type": "refused_proposal"}}],
        "ai": {"base": 5, "traits": {"vengeful": 12, "wrathful": 6, "cruel": 4}}}
     ]},

    {"id": "feud_sabotage", "title": "仇家作梗", "prompt": "{target} 家又在 {name} 家的田上動了手腳。兩家的仇，村裡人都知道。", "scope": "player_head", "budget": "feud", "chance": 0.035, "cooldown_years": 3,
     "conditions": {"is_head": true, "month": [4, 8]},
     "target": {"pick": "feud", "min_stage": 2, "conditions": {"is_head": true}},
     "options": [
       {"text": "告上莊園法庭", "log": ["{target} 家的豬又跑進了 {name} 家的麥田，{name} 告上莊園法庭，對方被罰了錢。",
                                    "{target} 趁夜把兩家田界上的石頭挪了一尺，{name} 告上莊園法庭，陪審的鄰居到田裡量了才算數。"],
        "effects": [{"deed": {"type": "trampled_crops", "doer": "target"}}, {"deed": {"type": "court_case"}}, {"target": [{"money": -6}]}, {"money": 4}],
        "ai": {"base": 8, "traits": {"ambitious": 4, "greedy": 4, "calm": 2}}},
       {"text": "把豬扣下來宰了", "log": "{target} 家的豬又跑進了 {name} 家的麥田，{name} 乾脆把豬扣下來宰了。",
        "effects": [{"deed": {"type": "trampled_crops", "doer": "target"}}, {"food": 30}, {"feud_heat": 10}],
        "ai": {"base": 4, "traits": {"wrathful": 10, "cruel": 6, "brave": 4, "calm": -6}}},
       {"text": "忍了", "log": "{target} 家的豬又跑進了 {name} 家的麥田，糟蹋了一大片，{name} 忍了下來。",
        "effects": [{"deed": {"type": "trampled_crops", "doer": "target"}}, {"food": -40}],
        "ai": {"base": 6, "traits": {"calm": 8, "craven": 8, "forgiving": 6}}}
     ]},

    {"id": "feud_brawl", "title": "冤家路窄", "prompt": "市集上，{name} 和仇家的 {target} 撞個正著。旁邊的人都停下來看。", "scope": "player_family", "budget": "feud", "chance": 0.02, "cooldown_years": 4,
     "conditions": {"sex": "male", "age": [16, 40]},
     "target": {"pick": "feud", "min_stage": 3, "conditions": {"sex": "male", "age": [16, 45]}},
     "options": [
       {"text": "動手", "log": "市集上，{name} 和仇家的 {target} 撞個正著，兩人二話不說就打了起來。",
        "effects": [{"deed": {"type": "brawl"}}, {"health": -8}, {"target": [{"health": -8}]}, {"trait_chance": {"trait": "scarred", "chance": 15}}],
        "ai": {"base": 6, "traits": {"wrathful": 12, "brave": 6, "vengeful": 6, "calm": -6}}},
       {"text": "繞道走開", "log": "市集上，{name} 遠遠看見仇家的 {target}，低著頭繞道走開了，背後傳來一陣笑聲。",
        "effects": [{"reputation": -1}, {"need": {"spirit": -10}}],
        "ai": {"base": 6, "traits": {"calm": 8, "craven": 8, "forgiving": 4}}}
     ]}
  ]
}
