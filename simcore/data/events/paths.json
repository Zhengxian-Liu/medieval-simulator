{
  "_doc": "人生的岔路 (design/life-paths.md): checkpoints at set ages whose options come from the family's means, standing and the places free; tries that can fail and send a life down another road; and the yearly lot of those living away (scope away). Stations are in data/paths.json.",
  "events": [
    {"id": "path_school", "title": "認字", "prompt": "神父願意教村裡的孩子認字。{name} {age} 歲了，家裡也正缺人手。", "scope": "anyone", "pulse": "yearly", "chance": 0.7, "parent_decides": true,
     "conditions": {"age": [7, 9], "station": "home", "no_flag": "school_decided", "is_head": false},
     "options": [
       {"text": "跟神父認字（12 便士）", "conditions": {"money_ge": 12}, "log": "{name} 開始跟神父認字。",
        "effects": [{"money": -12}, {"set_flag": "schooled"}, {"set_flag": "school_decided"}],
        "ai": {"base": 4, "traits": {"pious": 4, "ambitious": 4, "greedy": -4, "clever": 6, "dull": -6},
               "if": [{"cond": {"standing_ge": 2}, "add": 6}, {"cond": {"money_lt": 40}, "add": -3}, {"cond": {"tradition": "lettered"}, "add": 20}, {"cond": {"ambition": "educate_child"}, "add": 40}]}},
       {"text": "留在家幫忙", "log": "", "effects": [{"set_flag": "school_decided"}, {"skill": {"farming": 1}}], "ai": {"base": 12}},
       {"text": "送去別人家幫傭，換口飯吃", "conditions": {"any_place": "service", "money_lt": 30}, "log": "家裡揭不開鍋，{name} 才 {age} 歲就被送去別人家幫傭。",
        "effects": [{"set_flag": "school_decided"}, {"take_any_place": "service"}],
        "ai": {"base": 2, "if": [{"cond": {"food_days_lt": 60}, "add": 10}]}}
     ]},

