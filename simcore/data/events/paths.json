        "ai": {"base": 4, "if": [{"cond": {"money_lt": 20}, "add": 6}, {"cond": {"heir_apparent": true}, "add": -4}]}},
       {"text": "送去鎮上當學徒（50 便士，七年）", "conditions": {"free": true, "money_ge": 50}, "log": "{name} 跟著趕集的人進了城，拜了一個織布師傅，要學七年。",
        "effects": [{"money": -50}, {"set_flag": "trade_decided"}, {"station": {"id": "town_apprentice", "years": 7, "note": "進城拜師"}}],
        "ai": {"base": 2, "traits": {"ambitious": 6, "content": -4}, "if": [{"cond": {"heir_apparent": true}, "add": -12}, {"cond": {"money_ge": 150}, "add": 4}]}},
       {"text": "送去鎮上當學徒（50 便士，外加 15 便士給領主，准他離開莊園）", "conditions": {"free": false, "money_ge": 65}, "log": "{name} 家付了領主 15 便士，把他送進城拜了一個織布師傅，要學七年。",
        "effects": [{"money": -65}, {"set_flag": "trade_decided"}, {"station": {"id": "town_apprentice", "years": 7, "note": "進城拜師"}}],
        "ai": {"base": 2, "traits": {"ambitious": 6, "content": -4}, "if": [{"cond": {"heir_apparent": true}, "add": -12}, {"cond": {"money_ge": 150}, "add": 4}]}},
       {"text": "送去讀文法學校（40 便士，{odds}）", "conditions": {"flag": "schooled", "skill_ge": {"learning": 3}, "free": true, "money_ge": 40},
        "log": "",
        "effects": [{"set_flag": "trade_decided"},
                    {"odds": {"base": 35, "skill": {"learning": 8}, "traits": {"literate": 20, "clever": 15, "dull": -20}, "depends": "認字的底子",
                              "effects": [{"money": -40}, {"tell": "文法學校的先生考了 {name} 幾句拉丁文，收下了他。"}, {"station": {"id": "scholar", "years": [3, 4], "note": "進了文法學校"}}],
                              "else": [{"tell": "文法學校的先生考了 {name} 幾句拉丁文，搖了搖頭，叫他回家。"}]}}],
        "ai": {"base": 3, "traits": {"pious": 6, "ambitious": 4, "clever": 8}, "if": [{"cond": {"heir_apparent": true}, "add": -10}, {"cond": {"tradition": "lettered"}, "add": 15}]}},
       {"text": "送去讀文法學校（40 便士，外加 10 便士求領主准許，{odds}）", "conditions": {"flag": "schooled", "skill_ge": {"learning": 3}, "free": false, "money_ge": 50},
        "log": "",
        "effects": [{"set_flag": "trade_decided"},
                    {"odds": {"base": 25, "skill": {"learning": 8}, "traits": {"literate": 20, "clever": 15, "dull": -20}, "lord_opinion": 0.4, "depends": "認字的底子和領主肯不肯放人",
                              "effects": [{"money": -50}, {"tell": "領主收了 10 便士准了。文法學校的先生考了 {name} 幾句拉丁文，收下了他。"}, {"station": {"id": "scholar", "years": [3, 4], "note": "進了文法學校"}}],
                              "else": [{"tell": "文法學校的先生考了 {name} 幾句拉丁文，搖了搖頭，叫他回家。"}]}}],
        "ai": {"base": 3, "traits": {"pious": 6, "ambitious": 4, "clever": 8}, "if": [{"cond": {"heir_apparent": true}, "add": -10}, {"cond": {"tradition": "lettered"}, "add": 15}]}}
     ]},

