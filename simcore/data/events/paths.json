    {"id": "path_grown_m", "repeat": "person", "title": "長大了", "prompt": "{name} {age} 歲了。家裡的地將來歸誰，大家心裡都有數。", "scope": "anyone", "pulse": "yearly", "chance": 0.5, "parent_decides": true,
