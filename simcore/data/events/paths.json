                              "else": [{"tell": "文法學校的先生考了 {name} 幾句拉丁文，搖了搖頭，叫他回家。"}]}}],
        "ai": {"base": 3, "traits": {"pious": 6, "ambitious": 4, "clever": 8}, "if": [{"cond": {"heir_apparent": true}, "add": -10}, {"cond": {"tradition": "lettered"}, "add": 15}]}}
     ]},

