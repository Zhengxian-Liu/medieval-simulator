    {"id": "widow_suitor", "repeat": "person", "parent_decides": true, "title": "有地的寡婦", "prompt": "{target} 守了寡，一個人撐著家裡的地。村裡人說，誰娶了她，誰就有地種。（她手上的地要是寡婦產，只歸她在世時種，她死了就回到前夫家。）", "scope": "anyone", "pulse": "yearly", "chance": 0.25, "cooldown_years": 3,
