{
  // Life under the manor and the church calendar: service, flight, fasts and feasts.
  "events": [
    // The entry fine has come due and the money is short (contest.cpp): beg the lord for time (once), borrow
    // the rest from someone who will lend it, or let the lord take back the share of the land not paid for.
    {"id": "entry_fine_due", "title": "入地費", "prompt": "入地費的期限到了，家裡的錢不夠。付不出來，領主會把付不起的那部分地收回去，轉租給盯著它的人家。", "scope": "player_head", "chance": 1,
     "on": {"signal": "manual"},
     "options": [
       {"text": "去求領主再寬限半年", "conditions": {"fine_extended": false},
        "log": "{name} 帶著一隻閹雞去莊園，求 {target} 再寬限些日子。", "effects": [{"entry_fine": "beg"}],
        "ai": {"base": 10, "traits": {"craven": 4, "calm": 4}, "if": [{"cond": {"lord_opinion_lt": 0}, "add": -6}]}},
       {"text": "向人借錢補上", "conditions": {"fine_lender": true},
        "log": "{name} 硬著頭皮去借錢。", "effects": [{"entry_fine": "borrow"}],
        "ai": {"base": 12, "traits": {"greedy": -4}}},
       {"text": "交不出來，讓出一部分地", "log": "", "effects": [{"entry_fine": "forfeit"}],
        "ai": {"base": 3, "traits": {"content": 4}}}
     ]},
    {"id": "hard_master", "title": "苛刻的主人", "prompt": "{name} 在 {target} 家幫傭，常常挨打挨餓。期滿還有好幾年。", "scope": "player_family", "chance": 0.06, "cooldown_years": 6,
     "conditions": {"in_service": true},
     "target": {"pick": "head", "conditions": {"any": [{"trait": "cruel"}, {"trait": "wrathful"}, {"trait": "greedy"}]}},
     "options": [
       {"text": "忍到期滿", "log": "{name} 在 {target} 家幫傭，常常挨打挨餓，捎信回家只說一切都好。",
        "effects": [{"deed": {"type": "mistreated_servant", "doer": "target"}}, {"need": {"spirit": -20}}, {"health": -6}, {"trait_chance": {"trait": "melancholy", "chance": 15}}],
        "ai": {"base": 10, "traits": {"calm": 6, "craven": 6, "shy": 4}}},
       {"text": "連夜跑回家", "log": "{name} 受不了 {target} 的打罵，連夜跑回了家。",
        "effects": [{"deed": {"type": "mistreated_servant", "doer": "target"}}, {"end_service": true}, {"reputation": -1}],
        "ai": {"base": 6, "traits": {"brave": 8, "wrathful": 8}}}
     ]},
    {"id": "good_master", "title": "好主人", "scope": "player_family", "chance": 0.05, "cooldown_years": 6,
     "conditions": {"in_service": true},
     "target": {"pick": "head", "conditions": {"any": [{"trait": "kind"}, {"trait": "generous"}, {"trait": "calm"}]}},
     "options": [
       {"text": "好", "log": "{target} 待 {name} 像自家孩子，還手把手教{pron}本事。",
        "effects": [{"deed": {"type": "good_master", "doer": "target"}}, {"skill": {"craft": 1, "charm": 1}}, {"need": {"social": 15}}]}
     ]},
    {"id": "villein_flight", "title": "逃到鎮上", "prompt": "{name} 聽說鎮上缺人手，在城裡住滿一年零一天就是自由人。可農奴私逃，被抓回來要罰。", "scope": "player_family", "chance": 0.02, "cooldown_years": 5,
     "conditions": {"free": false, "sex": "male", "age": [17, 28], "married": false, "is_head": false, "heir_apparent": false, "year": [1350, 1500]},
     "options": [
       {"text": "放他走", "log": "{name} 聽說鎮上缺人手，在城裡住滿一年零一天就是自由人，趁夜離開了村子。家裡只能對領主的管家說不知道。",
        "effects": [{"leave_village": "fled_to_town"}],
        "ai": {"base": 6, "traits": {"brave": 8, "ambitious": 8, "content": -8}}},
       {"text": "留下來", "log": "{name} 想逃到鎮上去當自由人，最後還是捨不得家裡的地。",
        "effects": [{"need": {"spirit": -10}}],
        "ai": {"base": 10, "traits": {"content": 8, "craven": 6, "diligent": 4}}}
     ]},
    {"id": "lent_fast", "title": "四旬期", "prompt": "四旬期到了，四十天不能吃肉、蛋和乳酪。燻肉還掛在灶上。", "scope": "player_family", "chance": 0.02, "cooldown_years": 6, "cooldown_scope": "household",
     "conditions": {"month": [1, 2], "age": [14, 65]},
     "options": [
       {"text": "老老實實守齋", "log": "四旬期四十天不能吃肉、蛋和乳酪，{name} 天天只喝豆湯配鹹魚。",
        "effects": [{"need": {"spirit": 12}}, {"health": -2}],
        "ai": {"base": 10, "traits": {"pious": 12, "cynical": -6}}},
       {"text": "偷偷吃塊燻肉", "log": "{name} 在四旬期偷吃燻肉。",
        "effects": [{"need": {"hunger": 15}},
                    {"random": {"percent": 25, "effects": [{"reputation": -4}, {"money": -3}, {"log": "  鄰居聞到了肉味，告到神父那裡，{name} 被罰在主日當眾悔罪。"}], "else": []}}],
        "ai": {"base": 4, "traits": {"cynical": 10, "lustful": 4, "pious": -8}}}
     ]},
    {"id": "christmas_feast", "title": "聖誕節", "scope": "player_head", "chance": 0.3, "cooldown_years": 2,
     "conditions": {"month": 11},
     "target": {"pick": "lord", "conditions": {}},
     "options": [
       {"text": "好", "log": "聖誕節照例要送領主一隻母雞，領主也在大廳請佃戶們吃了一頓有肉有麥酒的大餐。{name} 一家吃得心滿意足。",
        "effects": [{"food": -5}, {"need": {"social": 25}}, {"need": {"spirit": 15}}, {"opinion": {"value": 3, "mod": "christmas_feast", "years": 2}}]}
     ]},
    {"id": "rogation_bounds", "title": "祈禱日巡界", "scope": "player_family", "chance": 0.06, "cooldown_years": 6,
     "conditions": {"month": 4, "age": [7, 12]},
     "options": [
       {"text": "好", "log": "祈禱日，全村跟著神父繞教區的地界走一圈。到了界石，大人把 {name} 倒提起來往石頭上碰一下，好讓{pron}一輩子記得地界在哪。",
        "effects": [{"need": {"social": 10}}]}
     ]}
  ]
}
