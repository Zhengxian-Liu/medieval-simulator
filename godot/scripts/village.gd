# Placeholder test village (metres, Y up): houses, river, bridge, torch, barrels, fences, rocks, trees.
# Flat-coloured on purpose; real textures and models replace these materials/meshes later.
extends RefCounted

const RIVER_Z := -14.0
const RIVER_HALF := 3.5  # shore-to-shore half width
const BED_DEPTH := 1.5
const RIVER_AMP := 3.0     # the river meanders: centre z = RIVER_Z + RIVER_AMP * sin(x * RIVER_FREQ + RIVER_PHASE)
const RIVER_FREQ := 0.07
const RIVER_PHASE := 0.6
const SHALLOWS := 1.4      # metres of shallow water (and sand) along each bank

static func river_center(x: float) -> float:
	return RIVER_Z + RIVER_AMP * sin(x * RIVER_FREQ + RIVER_PHASE)

static func river_dist(p: Vector2) -> float:
	return absf(p.y - river_center(p.x))

# Yaw (degrees) that lines a prop's local X up with the river's flow at x.
static func river_yaw(x: float) -> float:
	return -rad_to_deg(atan(RIVER_AMP * RIVER_FREQ * cos(x * RIVER_FREQ + RIVER_PHASE)))

# Ground height: flat land, a shelf of shallows inside each bank, then down to the bed.
static func ground_height(x: float, z: float) -> float:
	var d := river_dist(Vector2(x, z))
	if d >= RIVER_HALF:
		return 0.0
	if d > RIVER_HALF - SHALLOWS:
		return lerpf(0.0, -0.35, (RIVER_HALF - d) / SHALLOWS)
	return lerpf(-0.35, -BED_DEPTH, smoothstep(0.0, 1.0, (RIVER_HALF - SHALLOWS - d) / 0.8))

const COLORS := {
	grass = Color("4a5a2a"), stone = Color("6b6862"), plaster = Color("cfc2a6"),
	timber = Color("4a3220"), thatch = Color("8a6d3b"), iron = Color("222222"), cloth = Color("7a2e24"), riverbed = Color("4d4434"), dark = Color("15110d"),
}

# Poly Haven glTF sets: every mesh piece becomes one variant (see assets/CREDITS.md).
const PH := "res://assets/models/%s/%s.gltf"
const ROCK_SETS := [PH % ["rock_moss_set_01", "rock_moss_set_01"], PH % ["rock_moss_set_02", "rock_moss_set_02"], PH % ["boulder_01", "boulder_01"]]
const SHRUB_SETS := [PH % ["shrub_02", "shrub_02"]]
const SAPLING_SETS := [PH % ["pine_sapling_small", "pine_sapling_small"]]
# Generated by tools/make_trees.py (Blender); coloured by vertex colours.
# Broadleaf oaks and bushes from tools/make_foliage.py (surfaces "bark" and "leaves").
const FOLIAGE := "res://assets/models/foliage/%s.glb"
const TREE_SETS := ["res://assets/models/trees/fir_0.glb", "res://assets/models/trees/fir_1.glb", "res://assets/models/trees/fir_2.glb", "res://assets/models/trees/fir_3.glb"]

var _rng := RandomNumberGenerator.new()
var _ground: RefCounted
var _variants := {}

# Each variant: [mesh, offset] where offset moves the piece's AABB bottom-centre to the origin.
func _load_variants(sets: Array) -> Array:
	var key := ",".join(sets)
	if not _variants.has(key):
		var out := []
		for path in sets:
			var scene: Node = load(path).instantiate()
			_collect(scene, Transform3D.IDENTITY, out)
			scene.free()
		assert(not out.is_empty(), "no meshes in " + key)
		_variants[key] = out
	return _variants[key]

func _collect(n: Node, xf: Transform3D, out: Array) -> void:
	var t: Transform3D = xf * n.transform if n is Node3D else xf
	if n is MeshInstance3D:
		_fix_cutout(n.mesh)
		var box: AABB = t * n.get_aabb()
		var base := Vector3(box.get_center().x, box.position.y, box.get_center().z)
		out.append([n.mesh, Transform3D(t.basis, t.origin - base)])
	for c in n.get_children():
		_collect(c, t, out)

# Leaf cards use alpha scissor 0.5; mipmapping averages alpha below that at a distance and the leaves vanish
# (shrubs disappeared in the far view). A lower threshold plus alpha-to-coverage keeps them solid.
func _fix_cutout(mesh: Mesh) -> void:
	for i in mesh.get_surface_count():
		var m := mesh.surface_get_material(i) as BaseMaterial3D
		if m and m.transparency == BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR:
			m.alpha_scissor_threshold = 0.2
			m.alpha_antialiasing_mode = BaseMaterial3D.ALPHA_ANTIALIASING_ALPHA_TO_COVERAGE

func _place(root: Node3D, sets: Array, pos: Vector3, scale: float, material: Material = null) -> void:
	var variants := _load_variants(sets)
	var v: Array = variants[_rng.randi() % variants.size()]
	var mi := MeshInstance3D.new()
	mi.mesh = v[0]
	var spin := Transform3D(Basis(Vector3.UP, _rng.randf() * TAU).scaled(Vector3.ONE * scale), pos)
	mi.transform = spin * v[1]
	mi.material_override = material
	if material:  # foliage cards are single-sided geometry; cast from both faces or the shadow is mostly holes
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_DOUBLE_SIDED
	root.add_child(mi)
var _mats := {}

const Ground = preload("res://scripts/ground.gd")

# Slots with a Poly Haven texture set (see assets/CREDITS.md); others stay flat colour placeholders.
const TEXTURED := {grass = 0.25, riverbed = 0.4, stone = 0.6, plaster = 0.5, timber = 0.6, thatch = 0.5, rock = 0.8}  # tiles per metre

# leafy_grass reads as dry dirt from above; push it toward green.
const TINT := {grass = Color(0.5, 0.66, 0.42)}

func _mat(name: String) -> StandardMaterial3D:
	if not _mats.has(name):
		var m := StandardMaterial3D.new()
		m.roughness = 0.9
		m.cull_mode = BaseMaterial3D.CULL_DISABLED  # riverbed is a hand-built strip; avoid winding surprises
		var slot := "rock" if name == "stone_rock" else name
		if TEXTURED.has(slot):
			var dir := "res://assets/textures/%s/" % slot
			m.albedo_texture = load(dir + "albedo.jpg")
			m.normal_enabled = true
			m.normal_texture = load(dir + "normal.jpg")
			m.roughness_texture = load(dir + "roughness.jpg")
			m.roughness = 1.0
			# World-space triplanar: primitive meshes have no sensible UVs, and tiling stays the same size everywhere.
			m.uv1_triplanar = true
			m.uv1_world_triplanar = true
			m.uv1_scale = Vector3.ONE * TEXTURED[slot]
			m.albedo_color = TINT.get(slot, Color.WHITE)
		else:
			m.albedo_color = COLORS[name]
		m.resource_name = name  # slot name survives glTF export (tools/render_cycles.py re-textures by it)
		_mats[name] = m
	return _mats[name]

func _add(parent: Node3D, mesh: Mesh, mat: String, pos: Vector3, rot_y_deg := 0.0) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = _mat(mat)
	mi.position = pos
	mi.rotation_degrees.y = rot_y_deg
	parent.add_child(mi)
	return mi

func _box(size: Vector3) -> BoxMesh:
	var b := BoxMesh.new()
	b.size = size
	return b

func _cyl(top: float, bottom: float, height: float, sides := 8) -> CylinderMesh:
	var c := CylinderMesh.new()
	c.top_radius = top
	c.bottom_radius = bottom
	c.height = height
	c.radial_segments = sides
	return c

func build(root: Node3D) -> Node3D:
	_rng.seed = 7  # deterministic so screenshots are comparable between runs
	var houses := [[-9, 6, 10, "cottage"], [6, 9, -15, "barn"], [-3, 19, 80, "longhouse"], [15, -3, 40, "cottage"]]
	_ground = Ground.new()
	var bridge_x := 3.0
	var ground_mat: Material = _ground.build(root, houses, Vector2(2, 3), Vector2(bridge_x, river_center(bridge_x) + RIVER_HALF + 1.0),
		river_dist, RIVER_HALF, _rng, _mat("grass"))
	ground_mat.set_shader_parameter("river", Vector4(RIVER_Z, RIVER_AMP, RIVER_FREQ, RIVER_PHASE))
	ground_mat.set_shader_parameter("river_half", RIVER_HALF)
	_terrain(root, ground_mat)
	_water(root)
	var bridge := _add(root, _box(Vector3(2.4, 0.25, RIVER_HALF * 2.0 + 2.0)), "timber", Vector3(bridge_x, 0.3, river_center(bridge_x)))
	bridge.rotation_degrees.y = river_yaw(bridge_x)

	for h in houses:
		_house(root, Vector3(h[0], 0, h[1]), h[2], h[3])

	for h in houses:
		_dress_yard(root, h)
	_dress_square(root)

	_add(root, _cyl(0.05, 0.07, 1.6, 6), "iron", Vector3(1.5, 0.8, 1.5))
	var torch := OmniLight3D.new()
	torch.light_color = Color(1.0, 0.6, 0.25)
	torch.light_energy = 2.0
	torch.omni_range = 8.0
	torch.shadow_enabled = true
	torch.position = Vector3(1.5, 1.75, 1.5)
	root.add_child(torch)

	# Trees: a ring inside the far view plus a denser belt behind the village.
	for i in 40:
		var a := _rng.randf() * TAU
		var dist := (10.0 + _rng.randf() * 8.0) if i < 8 else (20.0 + _rng.randf() * 30.0)
		var p := Vector3(cos(a) * dist, 0, sin(a) * dist + 4.0)
		if river_dist(Vector2(p.x, p.z)) > RIVER_HALF + 1.5 and _clear_of_houses(p, houses, 6.5):
			if _rng.randf() < 0.65:  # mostly broadleaf oaks, some firs
				_instance(root, FOLIAGE % ("oak_%d" % _rng.randi_range(0, 2)), p, _rng.randf() * 360.0, _rng.randf_range(0.85, 1.15))
			else:
				_place(root, TREE_SETS, p, _rng.randf_range(0.8, 1.15), _foliage_mat())
	for i in 70:
		var along := i < 48  # most rocks line the banks, in small clusters
		var rx := _rng.randf_range(-32, 32)
		if along and absf(rx - 3.0) < 2.2:
			continue  # keep the bridge clear
		var p := Vector3(rx, 0.0, river_center(rx) + signf(_rng.randf() - 0.5) * _rng.randf_range(RIVER_HALF - 1.2, RIVER_HALF + 0.8)) if along \
			else Vector3(_rng.randf_range(-24, 24), 0.0, _rng.randf_range(-6, 28))
		if _clear_of_houses(p, houses, 4.5):
			for k in (3 if along else 1):
				var q := p + Vector3(_rng.randf_range(-0.8, 0.8), 0, _rng.randf_range(-0.6, 0.6)) * float(k > 0)
				q.y = ground_height(q.x, q.z) - 0.15  # sunk a little so they sit in the ground / bank
				_place(root, ROCK_SETS, q, _rng.randf_range(0.25, 0.75))
	for i in 70:  # bushes: scattered, plus clumps along the banks
		var bx := _rng.randf_range(-30, 30)
		var p := Vector3(bx, 0.0, _rng.randf_range(-8, 28)) if i < 45 \
			else Vector3(bx, 0.0, river_center(bx) + signf(_rng.randf() - 0.5) * _rng.randf_range(RIVER_HALF + 1.6, RIVER_HALF + 3.0))
		if river_dist(Vector2(p.x, p.z)) > RIVER_HALF + 1.4 and _clear_of_houses(p, houses, 4.2) and _ground.dirt_at(Vector2(p.x, p.z)) < 0.2:
			_bush(root, p)
	for h in houses:  # a bush or two hugging each house corner
		var size: Vector2 = FOOTPRINT[h[3]]
		for c in [Vector2(-1, -1), Vector2(1, -1)]:
			var local := Vector3(c.x * (size.x / 2 + 0.6), 0, c.y * (size.y / 2 + 0.6))
			var p: Vector3 = Vector3(h[0], 0, h[1]) + Basis(Vector3.UP, deg_to_rad(h[2])) * local
			if _ground.dirt_at(Vector2(p.x, p.z)) < 0.3:
				_bush(root, p)
	for i in 18:
		var p := Vector3(_rng.randf_range(-26, 26), 0.0, _rng.randf_range(-6, 28))
		if _clear_of_houses(p, houses, 4.5):
			_place(root, SAPLING_SETS, p, _rng.randf_range(0.8, 1.4))

	var player := _add(root, CapsuleMesh.new(), "cloth", Vector3(1, 1.0, 4))
	(player.mesh as CapsuleMesh).radius = 0.3
	(player.mesh as CapsuleMesh).height = 1.7
	player.position.y = 0.85
	return player

func _clear_of_houses(p: Vector3, houses: Array, radius: float) -> bool:
	for h in houses:
		if Vector2(p.x - h[0], p.z - h[1]).length() < radius:
			return false
	return true

# One terrain mesh for land, banks and riverbed (heights from ground_height), shaded by shaders/ground.gdshader.
func _terrain(root: Node3D, mat: Material) -> void:
	var half := 80.0
	var step := 0.6
	var n := int(half * 2 / step)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for j in n + 1:
		for i in n + 1:
			var x := -half + i * step
			var z := -half + j * step
			st.set_uv(Vector2(x, z))
			st.add_vertex(Vector3(x, ground_height(x, z), z))
	for j in n:
		for i in n:
			var a := j * (n + 1) + i
			for idx in [a, a + 1, a + n + 1, a + 1, a + n + 2, a + n + 1]:
				st.add_index(idx)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.name = "Terrain"
	mi.mesh = st.commit()
	mi.material_override = mat
	root.add_child(mi)

# Flat water sheet just below the banks; the land hides it everywhere except over the river channel.
func _water(root: Node3D) -> void:
	var surface := PlaneMesh.new()
	surface.size = Vector2(160, (RIVER_AMP + RIVER_HALF + 1.0) * 2.0)
	var water := MeshInstance3D.new()
	water.name = "Water"
	water.mesh = surface
	var sm := ShaderMaterial.new()
	sm.shader = load("res://shaders/water.gdshader")
	water.material_override = sm
	water.position = Vector3(0, -0.12, RIVER_Z)
	water.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	root.add_child(water)

# Buildings come from tools/hero_cottage.py; each surface is named after a material slot.
func _house(root: Node3D, pos: Vector3, yaw: float, variant: String) -> void:
	_instance(root, "res://assets/models/buildings/%s.glb" % variant, pos, yaw)

# Props come from tools/props.py; same material slots as the buildings.
const KEEP_OFF_PATHS := ["wattle_fence", "rail_fence", "handcart", "haystack", "drying_rack"]

func _prop(root: Node3D, name: String, pos: Vector3, yaw: float) -> void:
	if name in KEEP_OFF_PATHS and _ground.dirt_at(Vector2(pos.x, pos.z)) > 0.3:
		return  # never block a path or yard
	_instance(root, "res://assets/models/props/%s.glb" % name, pos, yaw + _rng.randf_range(-4.0, 4.0))

func _bush(root: Node3D, p: Vector3) -> void:
	_instance(root, FOLIAGE % ("bush_%d" % _rng.randi_range(0, 2)), p, _rng.randf() * 360.0, _rng.randf_range(0.8, 1.3))

func _instance(root: Node3D, path: String, pos: Vector3, yaw: float, scale := 1.0) -> void:
	var scene: Node3D = load(path).instantiate()
	scene.position = pos
	scene.rotation_degrees.y = yaw
	scene.scale = Vector3.ONE * scale
	root.add_child(scene)
	for mi in scene.find_children("*", "MeshInstance3D", true, false):
		var mesh: Mesh = mi.mesh
		for i in mesh.get_surface_count():
			var slot := mesh.surface_get_material(i).resource_name
			mi.set_surface_override_material(i, _weathered(slot))
	if not path.contains("/foliage/"):
		_ground_skirt(root, scene)

# Dirt/mud skirt projected onto the ground around an object's footprint: darkened, damp soil fading outward,
# so walls, props and rocks sit *in* the ground instead of on it (pre-rendered games never have a clean seam).
func _ground_skirt(root: Node3D, scene: Node3D) -> void:
	var box := AABB()
	var first := true
	for mi in scene.find_children("*", "MeshInstance3D", true, false):
		var b: AABB = (mi as MeshInstance3D).global_transform * (mi as MeshInstance3D).get_aabb()
		box = b if first else box.merge(b)
		first = false
	if first:
		return
	var d := Decal.new()
	d.texture_albedo = _skirt_texture()
	d.modulate = Color(0.16, 0.12, 0.08)
	d.albedo_mix = 1.0
	d.upper_fade = 0.15
	d.lower_fade = 0.15
	var pad := 0.9 + 0.12 * maxf(box.size.x, box.size.z)
	d.size = Vector3(box.size.x + pad * 2.0, 1.2, box.size.z + pad * 2.0)
	d.position = Vector3(box.get_center().x, box.position.y + 0.1, box.get_center().z)
	d.distance_fade_enabled = true
	d.distance_fade_begin = 60.0
	root.add_child(d)

var _skirt: Texture2D

func _skirt_texture() -> Texture2D:
	if _skirt == null:
		var g := Gradient.new()
		g.set_color(0, Color(1, 1, 1, 0.85))
		g.set_color(1, Color(1, 1, 1, 0.0))
		g.add_point(0.55, Color(1, 1, 1, 0.55))
		var t := GradientTexture2D.new()
		t.gradient = g
		t.fill = GradientTexture2D.FILL_SQUARE
		t.fill_from = Vector2(0.5, 0.5)
		t.fill_to = Vector2(1.0, 0.5)
		t.width = 128
		t.height = 128
		_skirt = t
	return _skirt

# Footprints (x along the ridge, z through the door side) of the buildings from tools/hero_cottage.py.
const FOOTPRINT := {cottage = Vector2(6.0, 4.5), longhouse = Vector2(9.5, 5.0), barn = Vector2(7.5, 5.5)}

# Yard dressing in the house's local frame (door on +Z): woodpile on a gable, barrels and a crate by the door,
# a wattle-fenced back yard; the barn gets a haystack and a handcart instead.
func _dress_yard(root: Node3D, h: Array) -> void:
	var size: Vector2 = FOOTPRINT[h[3]]
	var origin := Vector3(h[0], 0, h[1])
	var basis := Basis(Vector3.UP, deg_to_rad(h[2]))
	var put := func(name: String, local: Vector3, yaw: float) -> void:
		_prop(root, name, origin + basis * local, h[2] + yaw)
	var hw := size.x / 2
	var hd := size.y / 2
	if h[3] == "barn":
		put.call("haystack", Vector3(hw + 2.6, 0, -1.0), 0)
		put.call("handcart", Vector3(-hw - 2.2, 0, 1.5), 35)
		put.call("barrel", Vector3(-hw + 0.6, 0, hd + 0.7), 0)
		put.call("crate", Vector3(-hw + 1.4, 0, hd + 0.8), 12)
		put.call("crate", Vector3(-hw + 1.3, 0.7, hd + 0.8), -20)
		for i in 3:
			put.call("rail_fence", Vector3(-hw + 1.5 + i * 3.0, 0, -hd - 3.5), 0)
		return
	put.call("woodpile", Vector3(hw + 0.55, 0, 0.2), 90)
	put.call("barrel", Vector3(-1.5, 0, hd + 0.6), 0)
	put.call("barrel", Vector3(-2.1, 0, hd + 0.75), 0)
	put.call("crate", Vector3(1.4, 0, hd + 0.7), 15)
	put.call("drying_rack", Vector3(-0.5, 0, -hd - 2.0), 0)
	var segs := int(ceil(size.x / 2.4))
	for i in segs:
		put.call("wattle_fence", Vector3(-hw + 1.2 + i * 2.4, 0, -hd - 3.6), 0)
	for side in [-1, 1]:
		put.call("wattle_fence", Vector3(side * (hw + 0.4), 0, -hd - 2.3), 90)

func _dress_square(root: Node3D) -> void:
	_prop(root, "well", Vector3(4.0, 0, 5.5), 20)
	_prop(root, "handcart", Vector3(5.5, 0, 0.5), -60)
	_prop(root, "crate", Vector3(4.2, 0, -0.6), 0)
	_prop(root, "crate", Vector3(3.5, 0, -1.1), 25)
	_prop(root, "barrel", Vector3(4.8, 0, -1.4), 0)
	for x in [-2.5, -5.6, -8.7, 8.5, 11.6, 14.7]:  # rail fence along the south bank either side of the bridge
		_prop(root, "rail_fence", Vector3(x, 0, river_center(x) + RIVER_HALF + 1.6), river_yaw(x))

# Per-slot look of the weathered shader; numbers match the Cycles materials in tools/hero_cottage.py.
const WEATHER := {
	stone = {tint = Color(1, 1, 1), dirt_height = 0.6, moss = 0.7},
	plaster = {tint = Color(0.95, 0.92, 0.85), dirt_height = 1.1, moss = 0.0},
	timber = {tint = Color(0.9, 0.85, 0.8), dirt_height = 1.0, moss = 0.2},
	thatch = {tint = Color(0.78, 0.6, 0.38), dirt_height = 0.0, moss = 0.45},
}

func _weathered(slot: String) -> Material:
	var key := "weathered_" + slot
	if not _mats.has(key):
		if slot == "leaves":
			var lm := ShaderMaterial.new()
			lm.shader = load("res://shaders/leaves.gdshader")
			lm.set_shader_parameter("color_tex", load("res://assets/textures/leaves_oak/color.jpg"))
			lm.set_shader_parameter("opacity_tex", load("res://assets/textures/leaves_oak/opacity.jpg"))
			lm.set_shader_parameter("normal_tex", load("res://assets/textures/leaves_oak/normalgl.jpg"))
			_mats[key] = lm
		elif slot == "bark":
			var bm := StandardMaterial3D.new()
			var dir := "res://assets/models/pine_sapling_small/textures/pine_sapling_small_bark_"
			bm.albedo_texture = load(dir + "diff_1k.jpg")
			bm.normal_enabled = true
			bm.normal_texture = load(dir + "nor_gl_1k.jpg")
			bm.roughness_texture = load(dir + "arm_1k.jpg")
			bm.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_GREEN  # ARM packing: AO, roughness, metal
			_mats[key] = bm
		elif not WEATHER.has(slot):
			assert(slot in COLORS, "unknown material slot " + slot)
			_mats[key] = _mat(slot)
		else:
			var m := ShaderMaterial.new()
			m.shader = load("res://shaders/weathered.gdshader")
			var dir := "res://assets/textures/%s/" % slot
			m.set_shader_parameter("albedo_tex", load(dir + "albedo.jpg"))
			m.set_shader_parameter("normal_tex", load(dir + "normal.jpg"))
			m.set_shader_parameter("rough_tex", load(dir + "roughness.jpg"))
			for k in WEATHER[slot]:
				m.set_shader_parameter(k, WEATHER[slot][k])
			_mats[key] = m
	_mats[key].resource_name = slot  # keeps the slot name through glTF export (tools/render_cycles.py)
	return _mats[key]

func _foliage_mat() -> StandardMaterial3D:
	if not _mats.has("foliage"):
		var m := StandardMaterial3D.new()
		m.vertex_color_use_as_albedo = true
		m.vertex_color_is_srgb = true  # make_trees.py authors colours as sRGB values; without this they render washed out
		m.roughness = 0.85
		m.cull_mode = BaseMaterial3D.CULL_DISABLED  # branch cards are single-sided
		m.resource_name = "foliage"
		_mats["foliage"] = m
	return _mats["foliage"]
